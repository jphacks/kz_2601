# エージェントの PR で「人の確認が必須」にする場所(#370・#366)。scripts/agent-pr-guard.sh が読む。
# 1 行 1 項目: <種類> <パターン>。種類ごと・パターンの名前順。
# パターンはリポジトリの根からのパス。末尾が / ならその下すべて。* は / をまたいで一致する。
# 一覧は docs/backend/features/feedback-loop-agent-pr.md の「対象外の領域」と揃える。

# GitHub の設定・workflow
github .github/

# 認可
auth android/app/src/main/kotlin/jp/kz2601/metamon/auth/
auth android/services/src/main/kotlin/jp/kz2601/metamon/services/AuthService.kt
auth android/services/src/main/kotlin/jp/kz2601/metamon/services/live/FirebaseAuthService.kt
auth backend/internal/appcheck/
auth backend/internal/auth/
auth ios/Metamon/Features/Auth/

# 課金・コイン・使用量の上限
billing android/app/src/main/kotlin/jp/kz2601/metamon/purchase/
billing android/services/src/main/kotlin/jp/kz2601/metamon/services/purchase/
billing backend/cmd/*/coins.go
billing backend/cmd/appstore-reconcile/
billing backend/cmd/coin-initial-backfill/
