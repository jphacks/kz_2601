billing backend/internal/appstore/
billing backend/internal/budget/
billing backend/internal/coins/
billing backend/internal/entitlement/
billing backend/internal/paid/
billing backend/internal/ratelimit/
billing ios/Metamon/Features/Coins/
billing ios/Metamon/Features/Purchase/
billing ios/Packages/MetamonServices/Sources/MetamonServices/Coins/
billing ios/Packages/MetamonServices/Sources/MetamonServices/Purchase/
billing ios/StoreKit/

# データの削除
deletion backend/cmd/purge/
deletion backend/internal/store/*purge*

# 正典・法務・DSL のスキーマ
docs docs/00_decisions.md
docs docs/dsl/dsl.schema.json
docs docs/legal/

# この検査そのもの(一覧を緩める差分も人が見る)
guard scripts/agent-pr-guard-test.sh
guard scripts/agent-pr-guard.paths
guard scripts/agent-pr-guard.sh

# インフラ
infra infra/

# ループ自身
loop backend/cmd/feedback-loop/
loop backend/internal/loop/

# AI の指示文・カタログ
prompt */catalog.go
prompt */prompt.go

# 秘密の形をしたファイル(.gitignore の secrets と揃える)
secret *.env
secret *.env.*
secret *.key
secret *.p12
secret *.p8
secret *.pem
secret *GoogleService-Info*.plist
secret *google-services.json
secret *serviceAccountKey*.json
