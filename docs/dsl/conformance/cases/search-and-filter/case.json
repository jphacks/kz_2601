{
  "dsl": {
    "schemaVersion": 1,
    "app": {
      "name": "検索"
    },
    "initialScreen": "home",
    "entities": [
      {
        "id": "shop",
        "name": "店",
        "titleField": "name",
        "fields": [
          {
            "id": "name",
            "name": "名前",
            "type": "string"
          },
          {
            "id": "area",
            "name": "地域",
            "type": "enum",
            "options": [
              "金沢",
              "富山"
            ]
          },
          {
            "id": "visited",
            "name": "行った日",
            "type": "date"
          },
          {
            "id": "price",
            "name": "予算",
            "type": "currency",
            "unit": "円"
          }
        ]
      }
    ],
    "screens": [
      {
        "id": "home",
        "title": "店",
        "components": [
          {
            "type": "searchBar",
            "id": "q",
            "area": "A1:F1",
            "field": "q",
            "placeholder": "店の名前"
          },
          {
            "type": "list",
            "id": "shops",
            "area": "A2:F6",
            "entity": "shop",
            "searchField": "q",
            "item": {
              "title": "name",
              "subtitle": "area",
              "trailing": "price"
            },
            "sort": {
              "field": "price",
              "direction": "asc"
            }
          },
          {
            "type": "stat",
            "id": "kanazawa",
            "area": "A7:C8",
            "label": "金沢の平均予算",
            "entity": "shop",
            "aggregate": "avg",
            "field": "price",
            "filter": {
              "field": "area",
              "op": "eq",
              "value": "金沢"
            }
          },
          {
            "type": "stat",
            "id": "this_week",
            "area": "D7:F8",
            "label": "今週行った",
            "entity": "shop",
            "aggregate": "count",
            "filter": {
              "field": "visited",
              "op": "thisWeek"
            }
          },
          {
            "type": "timeline",
            "id": "tl",
            "area": "A9:F12",
            "entity": "shop",
            "dateField": "visited",
            "titleField": "name",
            "subtitleField": "area",
            "limit": 2
          }
        ]
      }
    ]
  },
  "records": {
    "shop": [
      {
        "id": "s1",
        "data": {
          "name": "金沢カレー",
          "area": "金沢",
