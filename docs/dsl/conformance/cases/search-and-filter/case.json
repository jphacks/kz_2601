          "price": 900
        }
      },
      {
        "id": "s2",
        "data": {
          "name": "富山ブラック",
          "area": "富山",
          "visited": "2026-11-01",
          "price": 1000
        }
      },
      {
        "id": "s3",
        "data": {
          "name": "金沢おでん",
          "area": "金沢",
          "visited": "2026-11-10",
          "price": 2500
        }
      }
    ]
  },
  "device": {
    "now": "2026-11-12T12:00:00+09:00",
    "timeZone": "Asia/Tokyo",
    "locale": "ja_JP"
  },
  "operations": [
    {
      "search": {
        "field": "q",
        "text": "金沢"
      }
    },
    {
      "search": {
        "field": "q",
        "text": "ブラック"
      }
    }
  ]
}
