      "expr": {"op": "daysUntil", "args": ["2026-10-29"]},
      "expected": {"type": "number", "value": 0, "text": "0"}
    },
    {
      "name": "tz/new-york/today-dst-end",
      "now": "2026-11-01T12:00:00-05:00",
      "timeZone": "America/New_York",
      "expr": {"op": "today", "args": []},
      "expected": {"type": "date", "value": "2026-11-01T00:00:00-04:00", "text": "2026-11-01"}
    },
    {
      "name": "tz/new-york/addDays-across-dst",
      "now": "2026-11-01T12:00:00-05:00",
      "timeZone": "America/New_York",
      "expr": {"op": "addDays", "args": [{"op": "today", "args": []}, 1]},
      "expected": {"type": "date", "value": "2026-11-02T00:00:00-05:00", "text": "2026-11-02"}
    },
    {
      "name": "tz/new-york/daysBetween-across-dst",
      "timeZone": "America/New_York",
