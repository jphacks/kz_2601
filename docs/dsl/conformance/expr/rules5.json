              "id": "ago",
              "name": "何か月前",
              "type": "integer",
              "computed": {
                "op": "sub",
                "args": [
                  {
                    "op": "add",
                    "args": [
                      {"op": "mul", "args": [{"op": "year", "args": [{"op": "today", "args": []}]}, 12]},
                      {"op": "month", "args": [{"op": "today", "args": []}]}
                    ]
                  },
                  {
                    "op": "add",
                    "args": [
                      {"op": "mul", "args": [{"op": "year", "args": [{"ref": "date"}]}, 12]},
                      {"op": "month", "args": [{"ref": "date"}]}
                    ]
                  }
                ]
              }
            }
          ]
        }
      ],
      "records": {
        "sale": [
          {"id": "6", "data": {"amount": 20000, "date": "2026-12-31", "store": "a"}},
          {"id": "7", "data": {"amount": 25000, "date": "2027-01-05", "store": "a"}}
        ],
        "store": [{"id": "a", "data": {"name": "駅前店"}}, {"id": "b", "data": {"name": "本店"}}]
      },
      "expected": {"type": "number", "value": 125, "text": "125"}
    },
    {
      "name": "rules5/ago-across-new-year",
      "now": "2027-01-10T12:00:00+09:00",
      "expr": {"ref": "ago"},
      "row": {"entity": "sale", "record": {"id": "6", "data": {"amount": 20000, "date": "2026-12-31", "store": "a"}}},
      "expected": {"type": "number", "value": 1, "text": "1"}
    }
  ]
}
