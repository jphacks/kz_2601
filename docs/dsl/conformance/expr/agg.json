{
  "description": "agg: count sum avg min max latest earliest, filters (period, comparison, refs, reserved values) and row context.",
  "defaults": {
    "now": "2026-10-28T15:30:45+09:00",
    "timeZone": "Asia/Tokyo",
    "entities": [
      {
        "id": "members",
        "name": "メンバー",
        "fields": [
          {"id": "name", "name": "名前", "type": "string"},
          {
            "id": "paid",
            "name": "支払済",
            "type": "currency",
            "computed": {
              "entity": "expenses",
              "agg": "sum",
              "field": "amount",
              "filter": {"value": {"ref": "id"}, "op": "eq", "field": "payer"}
            }
          },
          {
            "id": "share",
            "name": "負担額",
            "type": "currency",
            "computed": {
              "op": "round",
              "args": [
                {
                  "op": "div",
                  "args": [{"entity": "expenses", "agg": "sum", "field": "amount"}, {"entity": "members", "agg": "count"}]
                }
              ]
            }
          },
          {
            "id": "balance",
            "name": "残高",
            "type": "currency",
            "computed": {"op": "sub", "args": [{"ref": "paid"}, {"ref": "share"}]}
          }
        ],
        "titleField": "name"
      },
      {
        "id": "expenses",
        "name": "支出",
        "fields": [
          {"id": "title", "name": "内容", "type": "string"},
          {"id": "amount", "name": "金額", "type": "currency"},
          {"id": "payer", "name": "払った人", "type": "ref", "refEntity": "members"},
          {"id": "date", "name": "日付", "type": "date"},
          {"id": "tags", "name": "割る人", "type": "refs", "refEntity": "members"},
          {"id": "big", "name": "高額", "type": "boolean", "computed": {"op": "gte", "args": [{"ref": "amount"}, 1000]}}
        ],
        "titleField": "title"
      },
      {
        "id": "body",
        "name": "体重",
        "fields": [
          {"id": "weight", "name": "体重", "type": "number"},
          {"id": "date", "name": "日付", "type": "date"},
          {"id": "measured_at", "name": "測定日時", "type": "datetime"},
          {"id": "memo", "name": "メモ", "type": "string"}
        ]
      },
      {"id": "notes", "name": "メモ", "fields": [{"id": "text", "name": "本文", "type": "string"}]},
      {
        "id": "chores",
        "name": "家事",
        "fields": [{"id": "name", "name": "名前", "type": "string"}, {"id": "points", "name": "点数", "type": "integer"}]
      },
      {
        "id": "log",
        "name": "記録",
        "fields": [
          {"id": "chore", "name": "家事", "type": "ref", "refEntity": "chores"},
          {"id": "qty", "name": "回数", "type": "integer"},
          {
            "id": "score",
            "name": "点",
            "type": "integer",
            "computed": {"op": "mul", "args": [{"ref": "chore.points"}, {"ref": "qty"}]}
          }
        ]
      },
      {
        "id": "posts",
        "name": "投稿",
        "fields": [{"id": "text", "name": "本文", "type": "string"}, {"id": "at", "name": "日時", "type": "datetime"}],
        "marks": [{"id": "like", "icon": "heart", "label": "いいね"}],
        "scope": "shared"
      },
      {"id": "weeks", "name": "週", "fields": [{"id": "start", "name": "週の始まり", "type": "date"}]},
      {
        "id": "loop",
        "name": "循環",
        "fields": [
          {"id": "a", "name": "A", "type": "number", "computed": {"op": "add", "args": [{"ref": "b"}, 1]}},
          {"id": "b", "name": "B", "type": "number", "computed": {"op": "add", "args": [{"ref": "a"}, 1]}},
          {"id": "self", "name": "自分", "type": "number", "computed": {"op": "add", "args": [{"ref": "self"}, 1]}},
          {"id": "c", "name": "C", "type": "number", "computed": {"op": "coalesce", "args": [{"ref": "a"}, 42]}}
        ]
      }
    ],
    "records": {
