        "id": "members",
        "name": "メンバー",
        "fields": [
          {"id": "name", "name": "名前", "type": "string"},
          {
            "id": "paid",
            "name": "支払済",
            "type": "currency",
            "computed": {
              "entity": "expenses",
              "agg": "sum",
              "field": "amount",
              "filter": {"value": {"ref": "id"}, "op": "eq", "field": "payer"}
            }
          },
          {
            "id": "share",
            "name": "負担額",
            "type": "currency",
            "computed": {
              "op": "round",
              "args": [
                {
                  "op": "div",
                  "args": [{"entity": "expenses", "agg": "sum", "field": "amount"}, {"entity": "members", "agg": "count"}]
                }
              ]
            }
          },
          {
            "id": "balance",
            "name": "残高",
            "type": "currency",
            "computed": {"op": "sub", "args": [{"ref": "paid"}, {"ref": "share"}]}
          }
        ],
        "titleField": "name"
      },
      {
        "id": "expenses",
