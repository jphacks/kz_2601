        "fields": [
          {"id": "title", "name": "内容", "type": "string"},
          {"id": "amount", "name": "金額", "type": "currency"},
          {"id": "payer", "name": "払った人", "type": "ref", "refEntity": "members"},
          {"id": "date", "name": "日付", "type": "date"},
