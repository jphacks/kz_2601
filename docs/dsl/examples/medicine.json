{
  "schemaVersion": 1,
  "app": {
    "name": "服薬チェック",
    "description": "毎日飲む薬を登録しておき、飲んだら一覧の丸を 1 タップ。日付が変わると全部未チェックに戻る",
    "icon": "pills",
    "theme": { "primaryColor": "#5E35B1" },
    "voiceEntry": "floating"
  },
  "initialScreen": "home",
  "entities": [
    {
      "id": "medicine",
      "name": "薬",
      "titleField": "name",
      "fields": [
        { "id": "name", "name": "薬の名前", "type": "string", "required": true },
        { "id": "timing", "name": "飲むとき", "type": "enum", "options": ["朝", "昼", "夜", "寝る前"], "defaultValue": "朝" },
        { "id": "taken_on", "name": "飲んだ日", "type": "date" }
      ]
    }
  ],
  "screens": [
    {
      "id": "home",
      "title": "今日の薬",
      "toolbar": [
        { "label": "追加", "icon": "plus", "action": { "type": "navigate", "screen": "medicine_form", "presentation": "sheet" } }
      ],
      "components": [
        {
          "type": "hstack", "id": "summary", "area": "A1:F2",
          "children": [
            { "type": "stat", "label": "今日飲んだ(回)",
              "value": { "agg": "count", "entity": "medicine", "filter": { "field": "taken_on", "op": "today", "value": null } } },
            { "type": "stat", "label": "まだの薬",
              "value": { "op": "sub", "args": [
                { "agg": "count", "entity": "medicine" },
                { "agg": "count", "entity": "medicine", "filter": { "field": "taken_on", "op": "today", "value": null } }
              ] } }
          ]
        },
        {
          "type": "section", "id": "today", "area": "A3:F10", "title": "今日の薬",
          "children": [
            { "type": "list", "entity": "medicine",
              "item": { "title": "name", "subtitle": "timing", "toggle": "taken_on", "resets": "daily" },
              "emptyText": "毎日飲む薬を追加してください", "swipeToDelete": true,
              "onItemTap": { "type": "navigate", "screen": "medicine_form", "presentation": "push" } }
          ]
        },
        { "type": "button", "id": "add", "area": "D11:F12", "label": "薬を追加", "icon": "plus",
          "action": { "type": "navigate", "screen": "medicine_form", "presentation": "sheet" } }
      ]
    },
    {
      "id": "medicine_form",
      "title": "薬",
      "entity": "medicine",
      "toolbar": [{ "label": "保存", "icon": "checkmark", "action": { "type": "saveRecord", "entity": "medicine" } }],
      "components": [
        {
          "type": "section", "id": "fields", "area": "A1:F4", "title": "内容",
          "children": [
            { "type": "textField", "field": "name", "label": "薬の名前", "placeholder": "血圧の薬" },
            { "type": "picker", "field": "timing", "label": "飲むとき", "style": "segmented" }
          ]
        },
        { "type": "button", "id": "delete", "area": "A11:F12", "label": "削除", "style": "destructive",
          "action": { "type": "deleteRecord", "entity": "medicine", "confirmMessage": "この薬を削除しますか？" } }
      ]
    }
  ]
}
