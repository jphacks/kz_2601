{
  "schemaVersion": 1,
  "app": {
    "name": "AIのアイデア帳",
    "description": "ボタンを押すと AI が罰ゲームの案・励ましの一言・冷蔵庫の食材から今日の献立を書く(aiButton generate・#417)",
    "icon": "sparkles",
    "theme": { "primaryColor": "#00897B" },
    "voiceEntry": "floating",
    "tabs": [
      { "screen": "home", "title": "アイデア", "icon": "sparkles" },
      { "screen": "fridge", "title": "冷蔵庫", "icon": "refrigerator" }
    ]
  },
  "initialScreen": "home",
  "entities": [
    {
      "id": "food",
      "name": "食材",
      "titleField": "name",
      "fields": [
        { "id": "name", "name": "食材", "type": "string", "required": true },
        { "id": "amount", "name": "量", "type": "string" }
      ]
    }
  ],
  "screens": [
    {
      "id": "home",
      "title": "アイデア",
      "components": [
        { "type": "aiButton", "id": "batsu", "area": "A1:F7", "task": "generate", "label": "罰ゲームを考えて",
          "prompt": "飲み会や家族の集まりで盛り上がる、誰でも安全にできる軽い罰ゲームの案", "shape": "list", "count": 5 },
        { "type": "aiButton", "id": "cheer", "area": "A8:F11", "task": "generate", "label": "励ましの一言",
          "prompt": "疲れている人に向けた、短くて前向きな励ましの一言" }
      ]
    },
    {
      "id": "fridge",
      "title": "冷蔵庫",
      "components": [
        { "type": "aiButton", "id": "menu", "area": "A1:F6", "task": "generate", "label": "献立を提案して",
          "prompt": "{{input}} の食材でなるべく作れる、今日の晩ごはんの献立", "shape": "fields", "items": ["主菜", "副菜", "汁物"],
          "entity": "food", "limit": 20 },
        { "type": "list", "id": "foods", "area": "A7:F10", "entity": "food", "item": { "title": "name", "subtitle": "amount" },
          "emptyText": "冷蔵庫にある食材を追加してください", "swipeToDelete": true,
          "onItemTap": { "type": "navigate", "screen": "food_form", "presentation": "sheet" } },
        { "type": "button", "id": "add", "area": "D11:F12", "label": "食材を追加", "icon": "plus",
          "action": { "type": "navigate", "screen": "food_form", "presentation": "sheet" } }
      ]
    },
    {
      "id": "food_form",
      "title": "食材",
      "entity": "food",
      "toolbar": [{ "label": "保存", "icon": "checkmark", "action": { "type": "saveRecord", "entity": "food" } }],
      "components": [
        { "type": "textField", "id": "name", "area": "A1:F2", "field": "name", "label": "食材", "placeholder": "鮭" },
        { "type": "textField", "id": "amount", "area": "A3:F4", "field": "amount", "label": "量", "placeholder": "2 切れ" }
      ]
    }
  ]
}
