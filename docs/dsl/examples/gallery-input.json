{
  "schemaVersion": 1,
  "app": {
    "name": "入力部品ギャラリー",
    "description": "入力系コンポーネント(slider/stepper/textEditor/secureField/timePicker/colorPicker/rating/picker segmented)を1つのフォームに並べた見本",
    "icon": "slider.horizontal.3",
    "theme": { "primaryColor": "#5E35B1" },
    "voiceEntry": "floating"
  },
  "initialScreen": "home",
  "entities": [
    {
      "id": "checkin",
      "name": "今日の記録",
      "titleField": "note",
      "fields": [
        { "id": "mood", "name": "気分", "type": "enum", "required": true, "options": ["最高", "ふつう", "しんどい"], "defaultValue": "ふつう" },
        { "id": "energy", "name": "元気度", "type": "integer", "defaultValue": 5, "unit": "/10" },
        { "id": "cups", "name": "コーヒー", "type": "integer", "defaultValue": 1, "unit": "杯" },
        { "id": "weight", "name": "体重", "type": "number", "unit": "kg" },
        { "id": "stars", "name": "満足度", "type": "integer" },
        { "id": "wake_time", "name": "起床時刻", "type": "string", "defaultValue": "07:00" },
        { "id": "remind_at", "name": "通知時刻", "type": "datetime", "defaultValue": "now" },
        { "id": "color", "name": "テーマ色", "type": "string", "defaultValue": "#5E35B1" },
        { "id": "pin", "name": "ロック番号", "type": "string" },
        { "id": "note", "name": "ひとこと", "type": "text" },
        { "id": "date", "name": "日付", "type": "date", "required": true, "defaultValue": "now" }
      ]
    }
  ],
  "screens": [
    {
      "id": "home",
      "title": "入力部品ギャラリー",
      "toolbar": [
        { "label": "追加", "icon": "plus", "action": { "type": "navigate", "screen": "checkin_form", "presentation": "sheet" } }
      ],
      "components": [
        { "type": "stat", "id": "avg_stars", "area": "A1:F2", "label": "平均満足度", "entity": "checkin", "aggregate": "avg", "field": "stars" },
        { "type": "list", "id": "recent", "area": "A3:F10", "entity": "checkin",
          "item": { "title": "note", "subtitle": "mood", "trailing": "stars" },
          "sort": { "field": "date", "direction": "desc" }, "emptyText": "まだ記録がありません", "swipeToDelete": true,
          "onItemTap": { "type": "navigate", "screen": "checkin_form", "presentation": "push" } },
        { "type": "button", "id": "add", "area": "A11:F12", "label": "今日の記録をつける", "icon": "square.and.pencil",
          "action": { "type": "navigate", "screen": "checkin_form", "presentation": "sheet" } }
      ]
    },
    {
      "id": "checkin_form",
      "title": "今日の記録",
      "entity": "checkin",
      "toolbar": [{ "label": "保存", "icon": "checkmark", "action": { "type": "saveRecord", "entity": "checkin" } }],
      "components": [
        { "type": "picker", "id": "mood", "area": "A1:F2", "field": "mood", "label": "気分", "style": "segmented" },
        { "type": "slider", "id": "energy", "area": "A3:F4", "field": "energy", "label": "元気度", "min": 0, "max": 10, "step": 1 },
        { "type": "stepper", "id": "cups", "area": "A5:F5", "field": "cups", "label": "コーヒー(杯)", "min": 0, "max": 10 },
        { "type": "stepper", "id": "weight", "area": "A6:F6", "field": "weight", "label": "体重(kg)", "min": 30, "max": 150, "step": 0.1 },
        { "type": "rating", "id": "stars", "area": "A7:F8", "field": "stars", "label": "満足度", "max": 5 },
        { "type": "timePicker", "id": "wake_time", "area": "A9:C10", "field": "wake_time", "label": "起床" },
        { "type": "timePicker", "id": "remind_at", "area": "D9:F10", "field": "remind_at", "label": "通知" },
        { "type": "colorPicker", "id": "color", "area": "A11:F11", "field": "color", "label": "テーマ色" },
        { "type": "secureField", "id": "pin", "area": "A12:F12", "field": "pin", "label": "ロック番号", "placeholder": "4桁" },
        { "type": "textEditor", "id": "note", "area": "A13:F16", "field": "note", "placeholder": "今日あったことを自由に", "minLines": 4 },
        { "type": "datePicker", "id": "date", "area": "A17:F17", "field": "date", "label": "日付" },
        { "type": "button", "id": "delete", "area": "A18:F18", "label": "削除", "style": "destructive",
          "action": { "type": "deleteRecord", "entity": "checkin", "confirmMessage": "この記録を削除しますか？" } }
      ]
    }
  ]
}
