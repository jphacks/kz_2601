{
  "schemaVersion": 1,
  "app": {
    "name": "トレーニング記録",
    "description": "筋トレの種目・回数・重量を記録し、週ごとの回数を見る",
    "icon": "dumbbell",
    "theme": { "primaryColor": "#1565C0" },
    "voiceEntry": "floating",
    "notifications": [
      { "id": "morning", "title": "トレーニング", "body": "今日のトレーニングを記録しましょう", "repeat": "daily", "time": "08:00" }
    ]
  },
  "initialScreen": "home",
  "entities": [
    {
      "id": "workout",
      "name": "トレーニング",
      "titleField": "exercise",
      "fields": [
        { "id": "exercise", "name": "種目", "type": "enum", "required": true, "options": ["スクワット", "ベンチプレス", "デッドリフト", "懸垂", "ランニング"] },
        { "id": "reps", "name": "回数", "type": "integer", "required": true },
        { "id": "weight", "name": "重量", "type": "number", "unit": "kg" },
        { "id": "done", "name": "完了", "type": "boolean", "defaultValue": true },
        { "id": "date", "name": "日付", "type": "datetime", "required": true, "defaultValue": "now" }
      ]
    }
  ],
  "screens": [
    {
      "id": "home",
      "title": "トレーニング記録",
      "toolbar": [
        { "label": "追加", "icon": "plus", "action": { "type": "navigate", "screen": "workout_form", "presentation": "sheet" } }
      ],
      "components": [
        {
          "type": "hstack",
          "children": [
            { "type": "stat", "label": "今月の回数", "entity": "workout", "aggregate": "count", "filter": { "field": "date", "op": "thisMonth", "value": null } },
            { "type": "stat", "label": "最大重量", "entity": "workout", "aggregate": "max", "field": "weight", "format": "plain" }
          ]
        },
        { "type": "chart", "title": "週ごとの回数", "entity": "workout", "kind": "bar", "groupBy": "date", "bucket": "week", "aggregate": "sum", "field": "reps" },
        {
          "type": "list",
          "entity": "workout",
          "item": { "title": "exercise", "subtitle": "date", "trailing": "reps" },
          "sort": { "field": "date", "direction": "desc" },
          "swipeToDelete": true,
          "onItemTap": { "type": "navigate", "screen": "workout_form", "presentation": "push" }
        }
      ]
    },
    {
      "id": "workout_form",
      "title": "記録",
      "entity": "workout",
      "toolbar": [{ "label": "保存", "icon": "checkmark", "action": { "type": "saveRecord", "entity": "workout" } }],
      "components": [
        {
          "type": "section",
          "children": [
            { "type": "picker", "field": "exercise", "label": "種目", "style": "menu" },
            { "type": "numberField", "field": "reps", "label": "回数" },
            { "type": "numberField", "field": "weight", "label": "重量", "unit": "kg" },
            { "type": "toggle", "field": "done", "label": "完了" },
            { "type": "datePicker", "field": "date", "label": "日時", "includeTime": true }
          ]
        }
      ]
    }
  ]
}
