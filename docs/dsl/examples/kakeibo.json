{
  "schemaVersion": 1,
  "app": {
    "name": "家計簿",
    "description": "毎日の支出を記録して、月ごとの合計とカテゴリ内訳を見る",
    "icon": "yensign.circle",
    "theme": { "primaryColor": "#2E7D32", "mode": "system" },
    "voiceEntry": "floating"
  },
  "initialScreen": "home",
  "entities": [
    {
      "id": "expense",
      "name": "支出",
      "titleField": "memo",
      "fields": [
        { "id": "amount", "name": "金額", "type": "currency", "required": true, "unit": "円" },
        {
          "id": "category",
          "name": "カテゴリ",
          "type": "enum",
          "required": true,
          "options": ["食費", "交通", "日用品", "娯楽", "その他"],
          "defaultValue": "食費"
        },
        { "id": "memo", "name": "メモ", "type": "string" },
        { "id": "date", "name": "日付", "type": "date", "required": true, "defaultValue": "now" }
      ]
    }
  ],
  "screens": [
    {
      "id": "home",
      "title": "家計簿",
      "toolbar": [
        { "label": "追加", "icon": "plus", "action": { "type": "navigate", "screen": "expense_form", "presentation": "sheet" } }
      ],
      "components": [
        {
          "type": "hstack",
          "spacing": "medium",
          "children": [
            {
              "type": "stat",
              "id": "month_total",
              "label": "今月の支出",
              "entity": "expense",
              "aggregate": "sum",
              "field": "amount",
              "format": "currency",
              "filter": { "field": "date", "op": "thisMonth", "value": null }
            },
            {
              "type": "stat",
              "id": "month_count",
              "label": "件数",
              "entity": "expense",
              "aggregate": "count",
              "filter": { "field": "date", "op": "thisMonth", "value": null }
            }
          ]
        },
        {
          "type": "chart",
          "id": "by_category",
          "title": "カテゴリ別",
          "entity": "expense",
          "kind": "pie",
          "groupBy": "category",
          "aggregate": "sum",
          "field": "amount",
          "filter": { "field": "date", "op": "thisMonth", "value": null }
        },
        {
          "type": "section",
          "title": "最近の支出",
          "children": [
            {
              "type": "list",
              "id": "expenses",
              "entity": "expense",
              "item": { "title": "memo", "subtitle": "category", "trailing": "amount" },
              "sort": { "field": "date", "direction": "desc" },
              "emptyText": "まだ支出がありません",
              "swipeToDelete": true,
              "onItemTap": { "type": "navigate", "screen": "expense_form", "presentation": "push" }
            }
          ]
        }
      ]
    },
    {
      "id": "expense_form",
      "title": "支出を記録",
      "entity": "expense",
      "toolbar": [
        { "label": "保存", "icon": "checkmark", "action": { "type": "saveRecord", "entity": "expense" } }
      ],
      "components": [
        {
          "type": "section",
          "title": "内容",
          "children": [
            { "type": "numberField", "field": "amount", "label": "金額", "placeholder": "0", "unit": "円" },
            { "type": "picker", "field": "category", "label": "カテゴリ", "style": "segmented" },
            { "type": "textField", "field": "memo", "label": "メモ", "placeholder": "ランチ など" },
            { "type": "datePicker", "field": "date", "label": "日付" }
          ]
        },
        {
          "type": "button",
          "label": "削除",
          "style": "destructive",
          "action": { "type": "deleteRecord", "entity": "expense", "confirmMessage": "この支出を削除しますか？" }
        }
      ]
    }
  ]
}
