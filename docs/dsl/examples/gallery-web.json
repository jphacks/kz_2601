{
  "schemaVersion": 1,
  "app": {
    "name": "部品ギャラリー(Web・連携)",
    "description": "webView と shareButton の送り先 preset(LINE / Slack / Discord / 共有シート)、openUrlButton のカスタムスキーム(maps / tel / mailto / line)の配置見本",
    "icon": "globe",
    "theme": { "primaryColor": "#1E88E5" },
    "voiceEntry": "floating",
    "tabs": [
      { "screen": "news", "title": "ニュース", "icon": "newspaper" },
      { "screen": "share", "title": "送る", "icon": "paperplane" }
    ]
  },
  "initialScreen": "news",
  "entities": [
    {
      "id": "clip",
      "name": "クリップ",
      "titleField": "title",
      "fields": [
        { "id": "title", "name": "見出し", "type": "string", "required": true },
        { "id": "url", "name": "URL", "type": "string" },
        { "id": "comment", "name": "ひとこと", "type": "text" }
      ]
    }
  ],
  "screens": [
    {
      "id": "news",
      "title": "ニュース",
      "toolbar": [{ "label": "クリップ", "icon": "bookmark", "action": { "type": "navigate", "screen": "clip_form", "presentation": "sheet" } }],
      "components": [
        { "type": "webView", "id": "site", "area": "A1:F12", "url": "https://jphacks.com", "title": "JPHACKS" }
      ]
    },
    {
      "id": "share",
      "title": "友達に送る",
      "components": [
        { "type": "text", "id": "lead", "area": "A1:F1", "text": "送り先を選んで共有", "style": "headline" },
        { "type": "shareButton", "id": "to_line", "area": "A2:F3", "text": "JPHACKS 2026 の公式サイト https://jphacks.com", "shareTo": "line", "label": "LINE で送る" },
        { "type": "shareButton", "id": "to_slack", "area": "A4:C5", "text": "**今日の記事** https://jphacks.com", "shareTo": "slack", "label": "Slack へ" },
        { "type": "shareButton", "id": "to_discord", "area": "D4:F5", "text": "**今日の記事** https://jphacks.com", "shareTo": "discord", "label": "Discord へ" },
        { "type": "shareButton", "id": "to_any", "area": "A6:F7", "text": "JPHACKS 2026 https://jphacks.com", "label": "ほかのアプリで共有" },
        { "type": "divider", "id": "sep", "area": "A8:F8" },
        { "type": "openUrlButton", "id": "maps", "area": "A9:C10", "label": "会場を地図で開く", "url": "maps:?q=Kanazawa%20Station", "icon": "map", "style": "secondary" },
        { "type": "openUrlButton", "id": "call", "area": "D9:F10", "label": "電話する", "url": "tel:0761234567", "icon": "phone", "style": "secondary" },
        { "type": "openUrlButton", "id": "mail", "area": "A11:C12", "label": "メールで問い合わせ", "url": "mailto:info@example.com?subject=JPHACKS", "icon": "envelope", "style": "plain" },
        { "type": "openUrlButton", "id": "open_line", "area": "D11:F12", "label": "LINE を開く", "url": "line://nv/chat", "icon": "bubble.left.and.bubble.right", "style": "plain" }
      ]
    },
    {
      "id": "clip_form",
      "title": "クリップ",
      "entity": "clip",
      "toolbar": [{ "label": "保存", "icon": "checkmark", "action": { "type": "saveRecord", "entity": "clip" } }],
      "components": [
        { "type": "textField", "id": "title", "area": "A1:F2", "field": "title", "label": "見出し" },
        { "type": "textField", "id": "url", "area": "A3:F4", "field": "url", "label": "URL", "placeholder": "https://" },
        { "type": "textEditor", "id": "comment", "area": "A5:F8", "field": "comment", "placeholder": "ひとこと" },
        { "type": "shareButton", "id": "clip_line", "area": "A9:F10", "text": "{{title}}\n{{url}}", "field": "comment", "shareTo": "line", "label": "この記事を LINE で送る" }
      ]
    }
  ]
}
