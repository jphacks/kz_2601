{
  "schemaVersion": 1,
  "app": {
    "name": "部品ギャラリー(構造・ネイティブ)",
    "description": "card/disclosure/carousel/grid と searchBar/calendar/mapView/shareButton/openUrlButton/locationButton/qrScanner/timerDisplay の配置見本",
    "icon": "square.grid.2x2",
    "theme": { "primaryColor": "#00897B" },
    "voiceEntry": "floating",
    "tabs": [
      { "screen": "containers", "title": "構造", "icon": "rectangle.3.group" },
      { "screen": "native", "title": "ネイティブ", "icon": "iphone" }
    ]
  },
  "initialScreen": "containers",
  "entities": [
    {
      "id": "memo",
      "name": "メモ",
      "titleField": "note",
      "fields": [
        { "id": "photo", "name": "写真", "type": "photo" },
        { "id": "note", "name": "ひとこと", "type": "string", "required": true },
        { "id": "place", "name": "場所", "type": "location" },
        { "id": "code", "name": "QRコード", "type": "string" },
        { "id": "elapsed", "name": "経過秒", "type": "integer", "unit": "秒" },
        { "id": "date", "name": "日時", "type": "datetime", "required": true, "defaultValue": "now" }
      ]
    }
  ],
  "screens": [
    {
      "id": "containers",
      "title": "構造コンテナ",
      "components": [
        { "type": "card", "id": "hero", "area": "A1:F4", "title": "card",
          "children": [
            { "type": "text", "text": "角丸 + 影の1枚カード。見出しと集計をまとめる", "style": "body" },
            { "type": "stat", "label": "メモ件数", "entity": "memo", "aggregate": "count" }
          ] },
        { "type": "grid", "id": "tiles", "area": "A5:F6", "columnCount": 3,
          "children": [
            { "type": "stat", "label": "今日", "entity": "memo", "aggregate": "count", "filter": { "field": "date", "op": "today", "value": null } },
            { "type": "stat", "label": "今月", "entity": "memo", "aggregate": "count", "filter": { "field": "date", "op": "thisMonth", "value": null } },
            { "type": "stat", "label": "ぜんぶ", "entity": "memo", "aggregate": "count" }
          ] },
        { "type": "carousel", "id": "tips", "area": "A7:F9", "itemWidth": "medium",
          "children": [
            { "type": "text", "text": "1. 横スクロール", "style": "headline" },
            { "type": "text", "text": "2. itemWidth で幅を変える", "style": "headline" },
            { "type": "text", "text": "3. 子は Leaf だけ", "style": "headline" },
            { "type": "button", "label": "メモを追加", "icon": "plus", "action": { "type": "navigate", "screen": "memo_form", "presentation": "sheet" } }
          ] },
        { "type": "disclosure", "id": "more", "area": "A10:F12", "title": "disclosure(たたむ)", "expanded": false,
          "children": [
            { "type": "text", "text": "開くと詳細が出る。注意書きや補足に", "style": "caption" },
            { "type": "openUrlButton", "label": "JPHACKS 公式", "url": "https://jphacks.com", "icon": "safari", "style": "plain" }
          ] }
      ]
    },
    {
      "id": "native",
      "title": "ナビ・ネイティブ",
      "toolbar": [{ "label": "追加", "icon": "plus", "action": { "type": "navigate", "screen": "memo_form", "presentation": "sheet" } }],
      "components": [
        { "type": "searchBar", "id": "search", "area": "A1:F1", "field": "search", "placeholder": "メモを検索" },
        { "type": "list", "id": "memos", "area": "A2:F4", "entity": "memo", "searchField": "search",
          "item": { "title": "note", "subtitle": "date" },
          "sort": { "field": "date", "direction": "desc" },
          "emptyText": "メモがありません",
          "onItemTap": { "type": "navigate", "screen": "memo_form", "presentation": "sheet" } },
        { "type": "calendar", "id": "cal", "area": "A5:F11", "entity": "memo", "dateField": "date", "title": "カレンダー",
          "onDateTap": { "type": "navigate", "screen": "memo_form", "presentation": "sheet" } },
        { "type": "mapView", "id": "map", "area": "A12:F16", "entity": "memo", "locationField": "place", "titleField": "note", "zoom": "city",
          "onItemTap": { "type": "navigate", "screen": "memo_form", "presentation": "sheet" } },
        { "type": "timerDisplay", "id": "watch", "area": "A17:F19", "mode": "stopwatch", "label": "ストップウォッチ" },
        { "type": "shareButton", "id": "share", "area": "A20:C21", "text": "Tailor It で作ったアプリを見て！", "label": "共有", "icon": "square.and.arrow.up" },
        { "type": "openUrlButton", "id": "site", "area": "D20:F21", "label": "公式サイト", "url": "https://jphacks.com", "icon": "safari", "style": "secondary" }
      ]
    },
    {
      "id": "memo_form",
      "title": "メモ",
      "entity": "memo",
      "toolbar": [{ "label": "保存", "icon": "checkmark", "action": { "type": "saveRecord", "entity": "memo" } }],
      "components": [
        { "type": "textField", "id": "note", "area": "A1:F2", "field": "note", "label": "ひとこと", "placeholder": "きれいな紅葉" },
        { "type": "datePicker", "id": "date", "area": "A3:F4", "field": "date", "label": "日時" },
        { "type": "locationButton", "id": "here", "area": "A5:F6", "field": "place", "label": "現在地を記録" },
        { "type": "qrScanner", "id": "qr", "area": "A7:F8", "field": "code", "label": "QRを読み取る" },
        { "type": "timerDisplay", "id": "timer", "area": "A9:F12", "mode": "countdown", "seconds": 60, "field": "elapsed", "label": "1分タイマー" },
        { "type": "shareButton", "id": "share_memo", "area": "A13:F14", "text": "メモ: {{note}}", "field": "photo", "label": "このメモを共有" }
      ]
    }
  ]
}
