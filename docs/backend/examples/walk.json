{
  "schemaVersion": "0.1",
  "app": {
    "name": "散歩メモ",
    "description": "散歩中に見つけたものを写真とひとことで残す",
    "icon": "figure.walk",
    "theme": { "primaryColor": "#EF6C00" },
    "voiceEntry": "floating"
  },
  "initialScreen": "home",
  "entities": [
    {
      "id": "memo",
      "name": "メモ",
      "titleField": "note",
      "fields": [
        { "id": "photo", "name": "写真", "type": "photo" },
        { "id": "note", "name": "ひとこと", "type": "string", "required": true },
        { "id": "place", "name": "場所", "type": "location" },
        { "id": "date", "name": "日時", "type": "datetime", "required": true, "defaultValue": "now" }
      ]
    }
  ],
  "screens": [
    {
      "id": "home",
      "title": "散歩メモ",
      "toolbar": [{ "label": "撮る", "icon": "camera", "action": { "type": "navigate", "screen": "memo_form", "presentation": "fullScreen" } }],
      "components": [
        { "type": "stat", "label": "今日のメモ", "entity": "memo", "aggregate": "count", "filter": { "field": "date", "op": "today", "value": null } },
        {
          "type": "list",
          "entity": "memo",
          "item": { "title": "note", "subtitle": "date", "image": "photo" },
          "sort": { "field": "date", "direction": "desc" },
          "emptyText": "散歩に出かけて最初のメモを残そう",
          "swipeToDelete": true,
          "onItemTap": { "type": "navigate", "screen": "memo_form", "presentation": "push" }
        }
      ]
    },
    {
      "id": "memo_form",
      "title": "メモ",
      "entity": "memo",
      "toolbar": [{ "label": "保存", "icon": "checkmark", "action": { "type": "saveRecord", "entity": "memo" } }],
      "components": [
        { "type": "image", "field": "photo", "height": "large" },
        { "type": "photoField", "field": "photo", "label": "写真を撮る", "source": "camera" },
        { "type": "textField", "field": "note", "label": "ひとこと", "placeholder": "きれいな紅葉" },
        { "type": "button", "label": "30分後に思い出す", "style": "secondary",
          "action": { "type": "scheduleNotification", "notification": { "id": "remind_memo", "title": "散歩メモ", "body": "さっきのメモ、続きを書きませんか？", "repeat": "once", "time": "18:00" } } }
      ]
    }
  ]
}
