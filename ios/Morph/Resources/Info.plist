<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleDisplayName</key>
	<string>Morph</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- バックエンド URL。空ならモックで起動。ビルド時に xcconfig / 環境変数 MORPH_API_BASE_URL でも上書き可 -->
	<key>MorphAPIBaseURL</key>
	<string></string>

	<!-- WhisperKit モデル名。空なら `small`(約500MB・日本語精度優先)。環境変数 MORPH_WHISPER_MODEL でも上書き可 -->
	<key>MorphWhisperModel</key>
	<string></string>

	<!-- ネイティブ機能の権限説明(P0: マイク/カメラ/通知、P1: 位置/モーション) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>話しかけた内容からアプリを生成するために、マイクを使用します。</string>
	<key>NSCameraUsageDescription</key>
	<string>生成したアプリで写真を撮影・記録するために、カメラを使用します。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>生成したアプリで写真を選択・保存するために、写真ライブラリを使用します。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>撮影した写真を保存するために、写真ライブラリへの追加を使用します。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>生成したアプリで現在地を記録・表示するために、位置情報を使用します。</string>
	<key>NSMotionUsageDescription</key>
	<string>生成したアプリで歩数や動きを記録するために、モーションデータを使用します。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>オンデバイス音声認識が使えない場合の代替として、音声認識を使用します。</string>
</dict>
</plist>
