{
  "schemaVersion": 1,
  "appId": "demo",
  "version": 2,
  "name": "かんたん家計簿",
  "theme": { "accent": "#FF7A1A" },
  "state": {
    "draft": { "title": "", "amount": "", "category": "food" },
    "settings": { "notify": false }
  },
  "navigation": {
    "type": "tab",
    "tabs": [
      { "screen": "home", "title": "ホーム", "icon": "yensign.circle" },
      { "screen": "settings", "title": "設定", "icon": "gearshape" }
    ]
  },
  "screens": {
    "home": {
      "title": "今月の支出",
      "onAppear": [
        { "type": "entity.list", "entity": "expense", "into": "state.expenses" }
      ],
      "toolbar": [
        {
          "type": "button", "icon": "plus", "style": "plain",
          "action": { "type": "present", "screen": "new", "style": "sheet" }
        }
      ],
      "body": {
        "type": "vstack", "spacing": 16,
        "children": [
          {
            "type": "card", "title": "記録件数",
            "children": [
              { "type": "text", "text": "{{state.expenses.count}} 件", "style": "largeTitle" },
              { "type": "text", "text": "長押しで削除できます", "style": "caption", "color": "secondary" }
            ]
          },
          {
            "type": "section", "title": "明細",
            "children": [
              {
                "type": "list",
                "source": "{{state.expenses}}",
                "emptyText": "まだ支出がありません。右上の + から追加",
                "onTap": { "type": "navigate", "screen": "detail", "params": { "id": "{{item.id}}", "title": "{{item.title}}", "amount": "{{item.amount}}" } },
                "onDelete": {
                  "type": "sequence",
                  "actions": [
                    { "type": "entity.delete", "entity": "expense", "id": "{{item.id}}" },
                    { "type": "entity.list", "entity": "expense", "into": "state.expenses" }
                  ]
                },
                "item": {
                  "type": "card",
                  "children": [
                    {
                      "type": "hstack",
                      "children": [
                        { "type": "text", "text": "{{item.title}}", "style": "headline" },
                        { "type": "text", "text": "¥{{item.amount}}", "style": "headline", "align": "trailing" }
                      ]
                    },
                    { "type": "text", "text": "{{item.date}} · {{item.category}}", "style": "caption", "color": "secondary" }
                  ]
                }
              }
            ]
          },
          { "type": "hologram", "text": "未知のコンポーネントは無視される" }
        ]
      }
    },
    "new": {
      "title": "支出を追加",
      "body": {
        "type": "vstack", "spacing": 16,
        "children": [
          { "type": "textField", "bind": "state.draft.title", "placeholder": "内容(例: ランチ)" },
          { "type": "textField", "bind": "state.draft.amount", "placeholder": "金額", "keyboard": "number" },
          {
            "type": "picker", "bind": "state.draft.category", "label": "カテゴリ",
            "options": [
              { "label": "食費", "value": "food" },
              { "label": "交通", "value": "transport" },
              { "label": "その他", "value": "other" }
            ]
          },
          { "type": "camera", "bind": "state.draft.receipt", "label": "レシートを撮る" },
          {
            "type": "button", "label": "保存", "icon": "checkmark",
            "action": {
              "type": "sequence",
              "actions": [
                { "type": "entity.create", "entity": "expense",
                  "data": { "title": "{{state.draft.title}}", "amount": "{{state.draft.amount}}", "category": "{{state.draft.category}}", "date": "2026-10-24" } },
                { "type": "setState", "path": "state.draft", "value": { "title": "", "amount": "", "category": "food" } },
                { "type": "entity.list", "entity": "expense", "into": "state.expenses" },
                { "type": "native", "feature": "haptic", "args": { "style": "medium" } },
                { "type": "dismiss" }
              ]
            }
          }
        ]
      }
    },
    "detail": {
      "title": "{{params.title}}",
      "body": {
        "type": "vstack", "spacing": 16,
        "children": [
          { "type": "text", "text": "¥{{params.amount}}", "style": "largeTitle", "align": "center" },
          { "type": "divider" },
          { "type": "text", "text": "ID: {{params.id}}", "style": "caption", "color": "secondary" },
          { "type": "button", "label": "戻る", "style": "secondary", "action": { "type": "back" } }
        ]
      }
    },
    "settings": {
      "title": "設定",
      "body": {
        "type": "vstack", "spacing": 16,
        "children": [
          {
            "type": "section", "title": "通知",
            "children": [
              { "type": "toggle", "bind": "state.settings.notify", "label": "記録忘れを通知する" },
              {
                "type": "button", "label": "5秒後にテスト通知", "style": "secondary", "visible": "{{state.settings.notify}}",
                "action": { "type": "native", "feature": "notification.schedule", "args": { "title": "家計簿", "body": "今日の支出を記録しましょう", "inSeconds": 5 } }
              }
            ]
          },
          {
            "type": "section", "title": "お店の場所",
            "children": [
              { "type": "map", "lat": 36.5613, "lng": 136.6562, "span": 0.02, "pins": [ { "lat": 36.5613, "lng": 136.6562, "title": "金沢駅" } ] }
            ]
          },
          { "type": "button", "label": "アプリを作り直す", "style": "destructive", "icon": "arrow.counterclockwise",
            "action": { "type": "ai.prompt", "text": "最初の音声画面に戻して" } }
        ]
      }
    }
  }
}
