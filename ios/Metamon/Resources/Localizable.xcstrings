    " ・ あなたの公開": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · Published by you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " ・ あなたの公開"
          }
        }
      }
    },
    "%@ を入力してください": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please fill in %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を入力してください"
          }
        }
      }
    },
    "%@ ・ %lld 人が利用": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld users"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ・ %lld 人が利用"
          }
        }
      }
    },
    "%@。%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。%@"
          }
        }
      }
    },
    "%@。「アプリ一覧」と話すか、マイクを長押しすると前に作ったアプリを呼び出せます": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Say “App list” or long-press the mic to bring back an app you made"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。「アプリ一覧」と話すか、マイクを長押しすると前に作ったアプリを呼び出せます"
          }
        }
      }
    },
    "%@。前のアプリは、マイクの長押しからいつでも戻せます": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Long-press the mic anytime to go back to your previous app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。前のアプリは、マイクの長押しからいつでも戻せます"
          }
        }
      }
    },
    "%@。話しかけるだけで、アプリが生まれ変わります": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Just talk, and the app transforms"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。話しかけるだけで、アプリが生まれ変わります"
