    },
    "新しいアプリですね。\nどんなアプリにしますか?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new app.\nWhat kind of app?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいアプリですね。\nどんなアプリにしますか?"
          }
        }
      }
    },
    "新しいアプリを、いくつでも": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make as many new apps as you like"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいアプリを、いくつでも"
          }
        }
      }
    },
    "新しいアプリを声だけで相談している時は、内容がそろうと少し待ってから自動で作り始めます。作ったアプリの変更は、意図しない変更を防ぐため必ず「これでいく」を押してから反映します。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you plan a new app by voice only, building starts automatically shortly after everything is clear. Changes to an app you already made are applied only after you tap \"Go with this\", so nothing changes by accident."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいアプリを声だけで相談している時は、内容がそろうと少し待ってから自動で作り始めます。作ったアプリの変更は、意図しない変更を防ぐため必ず「これでいく」を押してから反映します。"
          }
        }
      }
    },
    "新しく作るアプリと質問もこの言語になります。作成済みのアプリの文言は変わりません。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New apps and questions will also use this language. Text in apps you already made stays the same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく作るアプリと質問もこの言語になります。作成済みのアプリの文言は変わりません。"
          }
        }
      }
    },
