    },
    "Tailor It で「%@」を使ってみて\n%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try “%1$@” on Tailor It\n%2$@"
