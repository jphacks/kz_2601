<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<!-- ホーム画面に出る表示名(正式名 Tailor It・#62)。値は project.yml の METAMON_DISPLAY_NAME(stg 系は「Tailor It β」・#292)。内部識別子 Metamon / Bundle ID jp.kz2601.metamon は Firebase 登録値なので変えない -->
	<key>CFBundleDisplayName</key>
	<string>$(METAMON_DISPLAY_NAME)</string>
	<!-- Siri が「Tailor It」を聞き取れない時の別名(App Shortcuts のフレーズ「Tailor It で記録を追加」にも効く・#80) -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>テイラーイット</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>テーラーイット</string>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UISupportsFullScreenInAssistiveAccess</key>
	<true/>
	<!-- 起動画面は SplashView の最初のコマ(無地の紺)と同じ色にして、つなぎ目を見せない -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- 横向き(左右)も使える(#625)。上下逆さまは無し。iPad は対象外(TARGETED_DEVICE_FAMILY = 1) -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- バックエンド URL(別々に設定可)。build setting METAMON_AI_BASE_URL / METAMON_APPCONFIG_BASE_URL から展開(project.yml・xcodebuild 引数)。
	     空ならその側はモック/インメモリ。実行時の環境変数 METAMON_AI_BASE_URL / METAMON_APPCONFIG_BASE_URL が優先 -->
	<key>MetamonAIBaseURL</key>
	<string>$(METAMON_AI_BASE_URL)</string>
	<key>MetamonAppConfigBaseURL</key>
	<string>$(METAMON_APPCONFIG_BASE_URL)</string>
	<!-- Firebase の環境(stg / prod)。build setting METAMON_FIREBASE_ENV(project.yml)。開発用メニューの「今の環境」に出す(#2079) -->
	<key>MetamonFirebaseEnv</key>
	<string>$(METAMON_FIREBASE_ENV)</string>
	<!-- 「アップデートしてください」のボタンの行き先(#302)。build setting METAMON_APP_STORE_URL(project.yml)。空なら App Store で「Tailor It」を検索。
	     appconfig の IOS_APP_STORE_URL があればそちらが優先 -->
	<key>MetamonAppStoreURL</key>
	<string>$(METAMON_APP_STORE_URL)</string>

	<!-- 開発時にローカル LAN の ai(http://<Mac の IP>:8081)へ接続するため。ローカルネットワーク限定で ATS 全体は無効化しない -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- openUrlButton / shareButton(shareTo)が他アプリの起動可否を確認するためのスキーム(ExternalURLPolicy の allowlist と対応)。tel/mailto/maps は OS 標準で不要 -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>line</string>
		<string>slack</string>
		<string>discord</string>
	</array>

	<!-- シェアリンク(#49): tailorit://import/<token> で開くと import してそのアプリに変身する(RootView の SharingHooks) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>jp.kz2601.metamon.share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tailorit</string>
			</array>
		</dict>
	</array>

	<!-- 連係の Handoff(#1851): 開いている生成アプリの画面を iPhone ⇄ Mac で引き継ぐ。Shared/Runtime/HandoffActivity.swift の type と同じ -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>jp.kz2601.metamon.view</string>
	</array>

	<!-- WhisperKit モデル名。空なら `small`(約500MB・日本語精度優先)。環境変数 METAMON_WHISPER_MODEL でも上書き可 -->
	<key>MetamonWhisperModel</key>
	<string></string>

	<!-- ライブアクティビティ(#423・ActivityKit)。端末内の更新だけなので push の設定・バックグラウンドモードは要らない -->
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- バックグラウンド(#38): 裏の定期同期(BGAppRefreshTask)。識別子は AppRuntime+Background.swift の BackgroundRefresh.identifier と一致させる。
	     fetch は Info.plist だけで有効になり、App ID 側の capability 操作は不要 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>jp.kz2601.metamon.refresh</string>
	</array>

	<!-- ネイティブ機能の権限説明(P0: マイク/カメラ/通知、P1: 位置/モーション) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>話しかけた内容からアプリを生成するため、また生成したアプリで話した内容を端末の中で文字にしたり、動画やドラレコの音声、ボイスメモ・会議などを録音したり、みんなで使うアプリで参加者と通話したりするために、マイクを使用します。</string>
	<!-- 止めるまで鳴るアラーム(Notification.alarm・AlarmKit・iOS 26.1 以降)。審査用の版では外す(strip-review-plist.sh) -->
	<key>NSAlarmKitUsageDescription</key>
	<string>生成したアプリで、設定した時刻にアラームを鳴らすために使用します。</string>
	<!-- U5: 音声モデル(WhisperKit)の準備中だけ、Apple の端末内の音声認識(requiresOnDeviceRecognition)で仮に聞き取る。声は端末の外に送らない -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>音声モデルの準備ができるまでの間、話した内容をこの端末の中で文字にするために、音声認識を使用します。声は端末の外に送りません。</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>生成したアプリの音楽プレーヤーで、Apple Music の曲を検索して再生するために使用します。</string>
	<key>NSCameraUsageDescription</key>
	<string>生成したアプリで写真や動画を撮影・記録するため、またドラレコとして画面を出している間に録画したり、みんなで使うアプリで参加者とビデオ通話したりするために、カメラを使用します。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>生成したアプリで写真や動画を選択・保存するために、写真ライブラリを使用します。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>生成したアプリの共有ボタンや QR コードの画像、ドラレコで保存した映像を写真に保存するために、写真ライブラリへの追加を使用します。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>生成したアプリで現在地を記録・地図に表示したり、目的地まで道案内したり、保存した場所の近くに着いた時に通知したりするために使います(近くに着いたかは端末の中で判定します)。「記録を開始」を押した時だけ、停止するまで(最長4時間)散歩などの道のりを記録し、その間はアプリを閉じても記録を続けます。</string>
	<!-- healthStat(#167): 歩数は CoreMotion の歩数計(capability 不要)。体重の読み書き・ヘルスケアの歩数は HealthKit。睡眠・心拍などは読むだけ(#1986)。英訳は InfoPlist.xcstrings -->
	<!-- sensorValue(#419): 気圧・高度(CMAltimeter)。傾き・加速度(device motion)は許可不要 -->
	<key>NSMotionUsageDescription</key>
	<string>生成したアプリで今日や最近の歩数、気圧や高度の変化を表示・記録するために、モーションとフィットネスのデータを使用します。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>生成したアプリで歩数・体重・睡眠・安静時心拍数・歩行と走行の距離・消費カロリー・エクササイズとマインドフルネスの時間を表示するために、ヘルスケアのデータを読み取ります。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>生成したアプリで記録した体重をヘルスケアにも保存するために、ヘルスケアへ書き込みます。</string>
	<!-- 端末のカレンダー・リマインダーを読む(#1987・DeviceCalendarSource)。英語は InfoPlist.xcstrings。審査用の版では外す(strip-review-plist.sh) -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>生成したアプリで、カレンダーの予定を一覧や今日の予定として表示するために、カレンダーを読み取ります。予定の題名や内容は端末の外に送りません。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>生成したアプリで、リマインダーを一覧や期限の近いものとして表示するために、リマインダーを読み取ります。リマインダーの題名や内容は端末の外に送りません。</string>
	<!-- Bluetooth の心拍ベルト(#2237・BLEHeartRate。標準の Heart Rate サービスだけ・アプリが前にいる間だけ)。英語は InfoPlist.xcstrings。審査用の版では外す(strip-review-plist.sh) -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>生成したアプリで、Bluetooth の心拍計(胸のベルトなど)から心拍数を読み取って表示・記録するために、Bluetooth を使用します。</string>
	<!-- nearbyShare(#36): MultipeerConnectivity で近くの Tailor It 端末と記録を送り合う。サービス名は NearbyService.serviceType と一致させる -->
	<!-- すれ違い通信(#425): _tailorit-pb は MCPassbyTransport.serviceType と一致させる -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>近くにいる Tailor It の端末を見つけて、記録や曲のリクエストをその場で送ったり受け取ったり、すれ違い通信で交換したりするために、ローカルネットワークを使用します。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_tailorit-mc._tcp</string>
		<string>_tailorit-mc._udp</string>
		<string>_tailorit-pb._tcp</string>
		<string>_tailorit-pb._udp</string>
	</array>
	<!-- すれ違い通信の distance(#425): Nearby Interaction(UWB)で近くの人との距離・方向を測る -->
	<!-- 記録のコピー・貼り付け(#1871): クリップボードに載せる独自の型。RecordClipboard.typeIdentifier と一致させる -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.tailorit.record</string>
			<key>UTTypeDescription</key>
			<string>Tailor It Record</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>生成したアプリで、すれ違い通信でつながった近くの人との距離と方向を表示するために使います。</string>
</dict>
</plist>
