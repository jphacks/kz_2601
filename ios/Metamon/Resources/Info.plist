<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<!-- ホーム画面に出る表示名はここ1箇所だけ。提出前に正式名を決める(商標要確認)。内部識別子 Metamon / Bundle ID jp.kz2601.metamon は Firebase 登録値なので変えない -->
	<key>CFBundleDisplayName</key>
	<string>メタモン</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- バックエンド URL(別々に設定可)。build setting METAMON_AI_BASE_URL / METAMON_APPCONFIG_BASE_URL から展開(project.yml・xcodebuild 引数)。
	     空ならその側はモック/インメモリ。実行時の環境変数 METAMON_AI_BASE_URL / METAMON_APPCONFIG_BASE_URL が優先 -->
	<key>MetamonAIBaseURL</key>
	<string>$(METAMON_AI_BASE_URL)</string>
	<key>MetamonAppConfigBaseURL</key>
	<string>$(METAMON_APPCONFIG_BASE_URL)</string>

	<!-- 開発時にローカル LAN の ai(http://<Mac の IP>:8081)へ接続するため。ローカルネットワーク限定で ATS 全体は無効化しない -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- WhisperKit モデル名。空なら `small`(約500MB・日本語精度優先)。環境変数 METAMON_WHISPER_MODEL でも上書き可 -->
	<key>MetamonWhisperModel</key>
	<string></string>

	<!-- ネイティブ機能の権限説明(P0: マイク/カメラ/通知、P1: 位置/モーション) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>話しかけた内容からアプリを生成するために、マイクを使用します。</string>
	<key>NSCameraUsageDescription</key>
	<string>生成したアプリで写真を撮影・記録するために、カメラを使用します。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>生成したアプリで写真を選択・保存するために、写真ライブラリを使用します。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>撮影した写真を保存するために、写真ライブラリへの追加を使用します。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>生成したアプリで現在地を記録・表示するために、位置情報を使用します。</string>
	<key>NSMotionUsageDescription</key>
	<string>生成したアプリで歩数や動きを記録するために、モーションデータを使用します。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>オンデバイス音声認識が使えない場合の代替として、音声認識を使用します。</string>
</dict>
</plist>
