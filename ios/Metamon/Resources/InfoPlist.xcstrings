{
  "sourceLanguage" : "ja",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads your Health data so the apps you build can show your steps, weight, sleep, resting heart rate, walking and running distance, active energy, and exercise and mindful minutes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成したアプリで歩数・体重・睡眠・安静時心拍数・歩行と走行の距離・消費カロリー・エクササイズとマインドフルネスの時間を表示するために、ヘルスケアのデータを読み取ります。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves the weight you record in the apps you build to Health as well."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成したアプリで記録した体重をヘルスケアにも保存するために、ヘルスケアへ書き込みます。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}