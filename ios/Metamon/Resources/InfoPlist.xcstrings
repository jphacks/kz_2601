{
  "sourceLanguage" : "ja",
  "strings" : {
    "NFCReaderUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used so the apps you build can read text and links from NFC tags, and write to them. What's read is never sent off this device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成したアプリで、NFC タグに書かれた文字や URL を読み取ったり、タグに書き込んだりするために使用します。読み取った内容は端末の外に送りません。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to read your heart rate from a Bluetooth heart rate monitor (such as a chest strap) so the apps you build can show and record it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成したアプリで、Bluetooth の心拍計(胸のベルトなど)から心拍数を読み取って表示・記録するために、Bluetooth を使用します。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to read your calendar so the apps you build can show your events in lists or as today's schedule. Event titles and details are never sent off this device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成したアプリで、カレンダーの予定を一覧や今日の予定として表示するために、カレンダーを読み取ります。予定の題名や内容は端末の外に送りません。"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to read the names, birthdays, and groups in your contacts so the apps you build can show them in lists. Contact details are never sent off this device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成したアプリで、連絡先の名前・誕生日・グループを一覧などに表示するために、連絡先を読み取ります。連絡先の内容は端末の外に送りません。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads your Health data so the apps you build can show your steps, weight, sleep, resting heart rate, walking and running distance, active energy, exercise and mindful minutes, workouts, and state of mind."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成したアプリで歩数・体重・睡眠・安静時心拍数・歩行と走行の距離・消費カロリー・エクササイズとマインドフルネスの時間・ワークアウト・気分を表示するために、ヘルスケアのデータを読み取ります。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves the weight and state of mind you record in the apps you build to Health as well."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成したアプリで記録した体重と気分をヘルスケアにも保存するために、ヘルスケアへ書き込みます。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by the apps you build to pick and save photos and videos in your photo library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成したアプリで写真や動画を選択・保存するために、写真ライブラリを使用します。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to read your reminders so the apps you build can show them in lists or by upcoming due date. Reminder titles and details are never sent off this device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成したアプリで、リマインダーを一覧や期限の近いものとして表示するために、リマインダーを読み取ります。リマインダーの題名や内容は端末の外に送りません。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}