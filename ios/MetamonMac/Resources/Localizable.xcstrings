        }
      }
    },
    "うまく聞き取れませんでした。押してから話し、話し終えたらもう一度押してください" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't catch that. Press, then speak, and press again when you're done."
