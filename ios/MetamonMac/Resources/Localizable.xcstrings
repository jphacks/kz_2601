    "いまは従量制の回線です。通信量が多いので、ほかの回線につないでからがおすすめです。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're on a metered connection. The download is large, so we recommend switching to another network first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いまは従量制の回線です。通信量が多いので、ほかの回線につないでからがおすすめです。"
          }
        }
      }
    },
    "うまく届きませんでした。もう一度送ってください" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That didn't go through. Please send it again"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うまく届きませんでした。もう一度送ってください"
          }
        }
      }
    },
    "うまく聞き取れませんでした。マイクに近づいて、もう一度話してください" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't catch that. Move closer to the microphone and speak again."
