          "stringUnit" : {
            "state" : "translated",
            "value" : "When the app crashes, where it crashed (the location in the code), your device model, OS, app version and user ID are sent to Google's Firebase Crashlytics and used to fix bugs. What you say, your records and the contents of your trackers are never sent."
          }
        },
        "ja" : {
