{
  "sourceLanguage": "ja",
  "strings": {
    "%@ を入力してください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please fill in %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を入力してください"
          }
        }
      }
    },
    "1日ごとの変化を折れ線グラフで見せて": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a line chart of how it changes day by day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日ごとの変化を折れ線グラフで見せて"
          }
        }
      }
    },
    "QRコードを読み取って記録できるようにして": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let me scan a QR code to log it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを読み取って記録できるようにして"
          }
        }
      }
    },
    "openUrl: url は https か line/slack/discord/tel/mailto/maps のみ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "openUrl: url must be https or line/slack/discord/tel/mailto/maps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "openUrl: url は https か line/slack/discord/tel/mailto/maps のみ"
          }
        }
      }
    },
    "「メモ」という言葉を「ひとこと」に変えて": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the word \"Memo\" to \"Comment\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メモ」という言葉を「ひとこと」に変えて"
          }
        }
      }
    },
    "「合計をもっと大きく表示して」のように、変えたい所を書いてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the change, like \"Make the total bigger.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「合計をもっと大きく表示して」のように、変えたい所を書いてください。"
          }
        }
      }
    },
    "「毎日の支出を記録して、今月の合計を見たい」のように、使い道を書いてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what it's for, like \"Log my daily spending and show this month's total.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「毎日の支出を記録して、今月の合計を見たい」のように、使い道を書いてください。"
          }
        }
      }
    },
    "「集計」のタブの名前を「グラフ」に変えて": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename the \"Summary\" tab to \"Charts\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「集計」のタブの名前を「グラフ」に変えて"
          }
        }
      }
    },
    "あなた: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた: %@"
          }
        }
      }
    },
    "うまく届きませんでした。もう一度送ってください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't go through. Please send it again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまく届きませんでした。もう一度送ってください"
          }
        }
      }
    },
    "お問い合わせ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact Us"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お問い合わせ"
          }
        }
      }
    },
    "ここに書いて Return で送る": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type here and press Return to send"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに書いて Return で送る"
          }
        }
      }
    },
    "ここまでの指示でアプリを直します": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the app with the instructions so far"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここまでの指示でアプリを直します"
          }
        }
      }
    },
    "このまま作って": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just build it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま作って"
          }
        }
      }
    },
    "このまま作る": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just build it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま作る"
          }
        }
      }
    },
    "このまま反映": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply as is"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま反映"
          }
        }
      }
