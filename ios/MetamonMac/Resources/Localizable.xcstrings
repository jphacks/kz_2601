        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま用意する"
          }
        }
      }
    },
    "このアプリを共有する": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share this app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリを共有する"
          }
        }
      }
    },
    "このアプリを直す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change this app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリを直す"
          }
        }
      }
    },
    "このデータは作った人だけが変更できます": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the person who created this can change it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデータは作った人だけが変更できます"
          }
        }
      }
    },
    "このボタンは Mac ではまだ使えません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This button doesn't work on Mac yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボタンは Mac ではまだ使えません"
          }
        }
      }
    },
    "この記録を家族だけで共有して": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share these records with my family only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記録を家族だけで共有して"
          }
        }
      }
    },
    "この記録帳を直す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change this tracker"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記録帳を直す"
          }
        }
      }
    },
    "これでいく": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go with this"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これでいく"
          }
        }
      }
    },
    "これでいく(%lld 件)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go with these (%lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これでいく(%lld 件)"
          }
        }
      }
    },
    "その場でカメラで撮って残せるようにして": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let me take a photo with the camera right there and save it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場でカメラで撮って残せるようにして"
          }
        }
      }
    },
    "できあがりました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All done"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "できあがりました"
          }
        }
      }
    },
    "できた画面に向かって、こう頼むと思いどおりに直せます。例を押すと入力欄に入るので、言葉を足してから送ってください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask like this to get the screen you want. Click an example to put it in the text box, then adjust the words before sending."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "できた画面に向かって、こう頼むと思いどおりに直せます。例を押すと入力欄に入るので、言葉を足してから送ってください。"
          }
        }
      }
    },
    "どこをどう直しますか?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to change?"
