    },
    "1日ごとの変化を折れ線グラフで見せて" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a line chart of how it changes day by day"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日ごとの変化を折れ線グラフで見せて"
