<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<!-- 表示名・Bundle ID・版は iOS と同じ build setting から(project.yml) -->
	<key>CFBundleDisplayName</key>
	<string>$(METAMON_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Mac はメニューバー(「〜について」「〜を終了」)に CFBundleName を出すので、内部名 Metamon でなく表示名にする -->
	<key>CFBundleName</key>
	<string>$(METAMON_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- バックエンド URL(iOS の Info.plist と同じキー・同じ build setting) -->
	<key>MetamonAIBaseURL</key>
	<string>$(METAMON_AI_BASE_URL)</string>
	<key>MetamonAppConfigBaseURL</key>
	<string>$(METAMON_APPCONFIG_BASE_URL)</string>
	<key>MetamonAppStoreURL</key>
	<string>$(METAMON_APP_STORE_URL)</string>

	<!-- WhisperKit のモデル名(#966)。空なら `small`(約500MB・日本語精度優先)。環境変数 METAMON_WHISPER_MODEL でも上書き可(iOS と同じ) -->
	<key>MetamonWhisperModel</key>
	<string></string>

	<!-- 声で頼む(#966)。文言は iOS と同じ。声は端末の外に送らない -->
	<key>NSMicrophoneUsageDescription</key>
	<string>話しかけた内容からアプリを生成するため、また生成したアプリで話した内容を端末の中で文字にしたり、動画やドラレコの音声、ボイスメモ・会議などを録音したりするために、マイクを使用します。</string>
	<!-- 音声モデルの準備中だけ、Apple の端末内の音声認識(requiresOnDeviceRecognition)で仮に聞き取る(iOS の U5 と同じ) -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>音声モデルの準備ができるまでの間、話した内容をこの端末の中で文字にするために、音声認識を使用します。声は端末の外に送りません。</string>
	<!-- ほかの権限の説明(カメラなど)は #931 で足す -->
</dict>
</plist>
