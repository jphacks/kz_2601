<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store に必須のサンドボックスと、通信(backend・音声モデルの取得)・マイク。カメラなどは各 Issue で足す -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- 声で頼む(#966): マイク。サンドボックスとハードンドランタイムの両方がこのキーを見る -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- カレンダーに追加(#978): 予定を足す(書き込みだけの許可を求める)。サンドボックスではこのキーが無いと EventKit に届かない -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- 現在地(#956): locationButton・地図・道案内など。サンドボックスではこのキーが無いと CoreLocation の許可を求められない -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- 利用者が選んだファイル: 取り込む(#956・fileImport)と、画像を保存…(#1333・保存パネルで選んだ場所へ書く) -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- プリント(#946・export の「プリント…」): サンドボックスではこのキーが無いとプリンタに出せない -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- サインイン(#930): Sign in with Apple(iOS と同じ App ID の capability) -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Firebase Auth は Mac ではログインの状態を Keychain(データ保護の Keychain)に置くので、Keychain Sharing が要る(firebase-ios-sdk の決まり・#930)。
	     グループは自分の App ID だけ(ほかのアプリとは共有しない) -->
	<!-- 共有のリンク(#1286): https://tailor-it.app/s/<token> を Universal Links で開く(iOS と同じ applinks)。
	     AASA の appIDs(Team ID + Bundle ID)は iOS と同じ jp.kz2601.metamon なので、Mac にも同じ行が効く(実機で確かめる)。
	     審査用の版は共有を外しているので MetamonMac-Review.entitlements に入れない -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(METAMON_APPLINKS_DOMAIN)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
