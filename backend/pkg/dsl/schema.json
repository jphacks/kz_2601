    "Area": {
      "type": "string",
      "pattern": "^[A-F][1-9][0-9]*:[A-F][1-9][0-9]*$",
      "description": "Grid rectangle on the screen's implicit grid, spreadsheet style 'A1:C3' = top-left cell : bottom-right cell. Columns A-F (screen width / 6), rows 1..N (row height = visible height / 12; rows > 12 make the screen scroll). Siblings with area must not overlap (Go validator). Only meaningful for direct children of a Screen; inside a Container children are stacked. Omit to stack below the grid (fallback)."
    },
    "Tab": {
      "type": "object",
