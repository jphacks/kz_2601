{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jphacks/kz_2601/docs/dsl/dsl.schema.json",
  "title": "AppDSL",
  "description": "Server-Driven UI DSL v1 (unified backend/iOS). Non-recursive by design (Claude structured output compatible): Screen > Container > Leaf. No numeric/string length constraints here; limits are enforced by the Go validator (backend/pkg/dsl). appId/version live in the API envelope (DSLEnvelope), never in this document. $defs/PatchDocument is the structured-output schema for edit turns (RFC 6902); iOS never sees patches. Layout: each Screen has an implicit 6-column grid (A-F) x rows of visibleHeight/12; components carry an optional `area` (\"A1:C3\") rectangle, non-overlapping among siblings; components without area stack below the grid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "app",
    "initialScreen",
    "entities",
    "screens"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Fixed 1 for v1. Bumped only on incompatible changes."
    },
    "app": {
      "$ref": "#/$defs/AppMeta"
    },
    "initialScreen": {
      "type": "string",
      "description": "Screen id shown at launch."
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entity"
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Screen"
      }
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "description": "snake_case or kebab-case ASCII id, unique within its scope. Validated by Go (^[a-z][a-z0-9_-]{0,39}$)."
    },
    "AppMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "voiceEntry"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "SF Symbols name, e.g. yensign.circle"
        },
        "theme": {
          "$ref": "#/$defs/Theme"
        },
        "voiceEntry": {
          "type": "string",
          "enum": [
            "fullscreen",
            "floating",
            "none"
          ],
          "description": "How the user re-enters voice mode to change the app. fullscreen = the initial voice-only state."
        },
        "notifications": {
          "type": "array",
          "description": "Local notifications iOS schedules when this DSL version is loaded (re-synced on every version).",
          "items": {
            "$ref": "#/$defs/Notification"
          }
        },
        "tabs": {
          "type": "array",
          "description": "Optional bottom tab bar (2-5 tabs). Each tab is its own navigation stack rooted at `screen`. initialScreen selects the starting tab when it matches one. Omit for a single-stack app.",
          "items": {
            "$ref": "#/$defs/Tab"
          }
        }
      }
    },
    "Theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "#RRGGBB"
        },
        "mode": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ]
        }
      }
    },
    "Entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "description": "Display name (ja ok)"
        },
        "titleField": {
          "type": "string",
          "description": "Field id used as the record title in lists."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        }
      }
    },
    "Field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "text",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime",
            "enum",
            "currency",
            "photo",
            "location"
          ],
          "description": "photo = image as \"data:image/jpeg;base64,...\" (iOS downsizes to <=800px, q0.5) or an https URL. location = \"lat,lng\" string (P1)."
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "description": "Only for type=enum.",
          "items": {
            "type": "string"
          }
        },
        "defaultValue": {
          "description": "Literal default. For date/datetime the string \"now\" is allowed.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "description": "e.g. 円, kg"
        }
      }
    },
    "Screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "components"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string"
        },
        "entity": {
          "type": "string",
          "description": "If set, the screen is a form over this entity: inputs with `field` bind to a draft record. Opened with a recordId -> edit mode."
        },
        "toolbar": {
          "type": "array",
          "description": "Trailing navigation-bar buttons.",
          "items": {
            "$ref": "#/$defs/ToolbarButton"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        }
      }
    },
    "ToolbarButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "action"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/Action"
        }
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "description": "ボタン・toolbar・list.onItemTap から実行される副作用。入れ子不可。confirmMessage はどの type にも付けられ、先に確認ダイアログを出す。",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "navigate",
            "back",
            "saveRecord",
            "deleteRecord",
            "openVoice",
            "openUrl",
            "resetForm",
            "scheduleNotification",
            "cancelNotification"
          ],
          "x-enumDescriptions": {
            "navigate": "画面遷移。list.onItemTap からは recordId が暗黙に渡り、遷移先フォームが編集モードになる。",
            "back": "前の画面へ戻る(push なら pop、モーダルなら dismiss)。",
            "saveRecord": "フォームのドラフトを保存(新規 POST / 編集 PATCH)して screen へ、無ければ back。フォーム画面の toolbar に置く。",
            "deleteRecord": "現在のレコードを削除して back。confirmMessage を付けるのが定石。",
            "openVoice": "音声シートを開く。",
            "openUrl": "URL を Safari で開く。",
            "resetForm": "フォームのドラフトを既定値に戻す。",
            "scheduleNotification": "ローカル通知をその場で予約(dsl.<id> で置換)。任意で押すリマインドはこれ。毎日の定期通知は app.notifications に宣言する。",
            "cancelNotification": "予約した通知を取り消す。"
          }
        },
        "screen": {
          "type": "string",
          "description": "navigate / saveRecord: target screen id.",
          "x-for": {
            "navigate": "required",
            "saveRecord": "optional"
          }
        },
        "presentation": {
          "type": "string",
          "enum": [
            "push",
            "sheet",
            "fullScreen"
          ],
          "x-for": {
            "navigate": "optional"
          }
        },
        "entity": {
          "type": "string",
          "description": "saveRecord / deleteRecord: entity id.",
          "x-for": {
            "saveRecord": "required",
            "deleteRecord": "required"
          }
        },
        "url": {
          "type": "string",
          "format": "uri",
          "x-for": {
            "openUrl": "required"
          }
        },
        "confirmMessage": {
          "type": "string",
          "description": "If set, iOS shows a confirm dialog first."
        },
        "notification": {
          "$ref": "#/$defs/Notification",
          "description": "scheduleNotification only.",
          "x-for": {
            "scheduleNotification": "required"
          }
        },
        "notificationId": {
          "type": "string",
          "description": "cancelNotification only.",
          "x-for": {
            "cancelNotification": "required"
          }
        }
      }
    },
    "Component": {
      "description": "Top-level component inside a screen. Containers may hold Leaf children (one level only).",
      "anyOf": [
        {
          "$ref": "#/$defs/Container"
        },
        {
          "$ref": "#/$defs/Leaf"
        }
      ]
    },
    "Container": {
      "type": "object",
      "additionalProperties": false,
      "description": "子 Leaf を並べる器。1 段のみ(Container の中に Container は置けない)。Screen 直下で area を持ち、子は積むだけ(子に area は付けない)。",
      "x-usage": "可変長なのでセル内スクロールする。指標カード = hstack に stat を 2〜3 枚入れて A1:F2。フォーム = section に入力部品を並べて A1:F7 程度。一覧 = section に list を 1 つ入れて A3:F10。",
      "required": [
        "type",
        "children"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "vstack",
            "hstack",
            "section"
          ],
          "x-enumDescriptions": {
            "vstack": "子を縦に積む。入力欄やボタンをまとめる既定の器。",
            "hstack": "子を横に並べる。stat を 2〜3 枚並べて指標カードにする時に使う。",
            "section": "見出し(title)付きのグループ。フォームの入力欄や一覧の見出しに使う。"
          }
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "area": {
          "$ref": "#/$defs/Area"
        },
        "title": {
          "type": "string",
          "description": "section only.",
          "x-for": {
            "section": "optional"
          }
        },
        "spacing": {
          "type": "string",
          "enum": [
            "none",
            "small",
            "medium",
            "large"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Leaf"
          }
        }
      }
    },
    "Leaf": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "$ref": "#/$defs/Button"
        },
        {
          "$ref": "#/$defs/TextField"
        },
        {
          "$ref": "#/$defs/NumberField"
        },
        {
          "$ref": "#/$defs/DatePicker"
        },
        {
          "$ref": "#/$defs/Picker"
        },
        {
          "$ref": "#/$defs/Toggle"
        },
        {
          "$ref": "#/$defs/PhotoField"
        },
        {
          "$ref": "#/$defs/Image"
        },
        {
          "$ref": "#/$defs/List"
        },
        {
          "$ref": "#/$defs/Stat"
        },
        {
          "$ref": "#/$defs/Chart"
        },
        {
          "$ref": "#/$defs/VoiceInput"
        },
        {
          "$ref": "#/$defs/Spacer"
        },
        {
          "$ref": "#/$defs/Divider"
        },
        {
          "$ref": "#/$defs/Label"
        },
        {
          "$ref": "#/$defs/Icon"
        },
        {
          "$ref": "#/$defs/ProgressBar"
        },
        {
          "$ref": "#/$defs/Gauge"
        },
        {
          "$ref": "#/$defs/Badge"
        },
        {
          "$ref": "#/$defs/Link"
        },
        {
          "$ref": "#/$defs/Markdown"
        },
        {
          "$ref": "#/$defs/Avatar"
        },
        {
          "$ref": "#/$defs/Table"
        },
        {
          "$ref": "#/$defs/Timeline"
        },
        {
          "$ref": "#/$defs/EmptyState"
        }
      ]
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "description": "固定の見出し・説明文・注意書き。レコードの値は表示しない(値は stat / list / image で)。",
      "x-usage": "style は title(画面内見出し)/ headline / body / caption(補足)。長文はセル内でスクロールする。",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "area": {
          "$ref": "#/$defs/Area"
        },
        "text": {
          "type": "string"
        },
        "style": {
          "type": "string",
          "enum": [
            "title",
            "headline",
            "body",
            "caption"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "leading",
            "center",
            "trailing"
          ]
        }
      }
    },
    "Button": {
      "type": "object",
      "additionalProperties": false,
      "description": "タップで action を実行するボタン。画面遷移・保存・削除・通知予約・音声の入口。",
      "x-usage": "追加ボタンは右下 D11:F12 に primary、削除は destructive でフォーム下部 A11:F12。toolbar にも同じ action を置ける。",
      "required": [
        "type",
        "label",
        "action"
      ],
      "properties": {
        "type": {
          "const": "button"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "area": {
          "$ref": "#/$defs/Area"
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "style": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "destructive",
            "plain"
          ]
        },
        "action": {
          "$ref": "#/$defs/Action"
        }
      }
    },
    "TextField": {
      "type": "object",
      "additionalProperties": false,
      "description": "文字入力(string / text field)。multiline:true で複数行。",
      "x-usage": "screen.entity のあるフォーム画面にのみ置く。メモ・感想・コメントなど自由文は multiline:true。",
      "required": [
        "type",
        "field"
      ],
      "properties": {
        "type": {
          "const": "textField"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "area": {
          "$ref": "#/$defs/Area"
        },
        "field": {
          "type": "string",
          "description": "Field id of the screen entity."
        },
        "label": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "multiline": {
          "type": "boolean"
        }
      }
    },
    "NumberField": {
      "type": "object",
      "additionalProperties": false,
      "description": "数値入力(integer / number / currency field)。unit で単位(円・kg・回)を添える。",
      "x-usage": "金額は currency field + unit 円。回数・量・体重は integer / number。",
      "required": [
        "type",
        "field"
      ],
      "properties": {
        "type": {
          "const": "numberField"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "area": {
          "$ref": "#/$defs/Area"
        },
        "field": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "DatePicker": {
      "type": "object",
      "additionalProperties": false,
      "description": "日付(date)または日時(datetime・includeTime:true)の入力。",
      "x-usage": "日付 field は defaultValue \"now\" にして入力の手間を省く。時刻まで要るときだけ includeTime:true。",
      "required": [
        "type",
        "field"
      ],
      "properties": {
        "type": {
          "const": "datePicker"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "area": {
          "$ref": "#/$defs/Area"
        },
        "field": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "includeTime": {
          "type": "boolean"
        }
      }
    },
    "Picker": {
      "type": "object",
      "additionalProperties": false,
      "description": "選択肢から 1 つ選ぶ入力(enum field の options が選択肢)。カテゴリ・種類・気分など。",
      "x-usage": "選択肢が 2〜4 個なら segmented、多ければ menu。",
      "required": [
        "type",
        "field"
      ],
      "properties": {
        "type": {
          "const": "picker"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "area": {
          "$ref": "#/$defs/Area"
        },
        "field": {
          "type": "string",
          "description": "Must be an enum field; options come from the field."
        },
        "label": {
          "type": "string"
        },
        "style": {
          "type": "string",
          "enum": [
            "menu",
            "segmented",
            "wheel"
          ]
        }
      }
    },
    "Toggle": {
      "type": "object",
      "additionalProperties": false,
      "description": "ON/OFF スイッチ(boolean field)。完了・済み・お気に入りなどのチェック。",
      "x-usage": "「買ったらチェック」のような完了フラグはこれ。一覧側は filter(eq false)で未完了だけに絞れる。",
      "required": [
        "type",
        "field",
        "label"
      ],
      "properties": {
        "type": {
          "const": "toggle"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "area": {
          "$ref": "#/$defs/Area"
        },
        "field": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "List": {
      "type": "object",
      "additionalProperties": false,
      "description": "entity のレコード一覧。行の表示は item に field id を割り当て、タップで onItemTap(通常はフォームへ navigate → 編集モード)。",
      "x-usage": "可変長なので大きめの矩形 A3:F10 でセル内スクロール。sort は日付 desc が既定、swipeToDelete:true で削除。カレンダー / タイムライン / 履歴 / 日記風の表示は日付でソートした list で代替する。",
      "required": [
        "type",
        "entity",
        "item"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "area": {
          "$ref": "#/$defs/Area"
        },
        "entity": {
          "type": "string"
        },
        "item": {
          "$ref": "#/$defs/ListItem"
        },
        "sort": {
          "$ref": "#/$defs/Sort"
        },
        "filter": {
          "$ref": "#/$defs/Filter"
        },
        "emptyText": {
          "type": "string"
        },
        "onItemTap": {
          "$ref": "#/$defs/Action",
          "description": "Usually navigate to a form screen; iOS passes recordId."
        },
        "swipeToDelete": {
          "type": "boolean"
        }
      }
    },
    "ListItem": {
      "type": "object",
      "additionalProperties": false,
      "description": "list の 1 行。各キーは field id。title は必須、trailing に金額や日付、image に photo field でサムネイル。",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Field id."
        },
        "subtitle": {
          "type": "string",
          "description": "Field id."
        },
        "trailing": {
          "type": "string",
          "description": "Field id (e.g. amount, date)."
        },
        "icon": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "description": "Field id of a photo field shown as thumbnail."
        }
      }
    },
    "Sort": {
      "type": "object",
      "additionalProperties": false,
      "description": "list の並び順。",
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    },
    "Filter": {
      "type": "object",
      "additionalProperties": false,
      "description": "list / stat / chart のレコード絞り込み。op が thisMonth / today のときは value を null にする。",
      "required": [
        "field",
        "op",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "thisMonth",
            "today"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Stat": {
      "type": "object",
      "additionalProperties": false,
      "description": "集計値 1 つのカード(件数・合計・平均・最小・最大)。今月の合計・今日の件数・平均体重など。",
      "x-usage": "2〜3 枚を hstack に入れて A1:F2 に横並び、または単体で A1:C2 / D1:F2。filter で thisMonth / today(value は null)。金額は format currency。",
      "required": [
        "type",
        "label",
        "entity",
