{
  "schemaVersion": 1,
  "app": {
    "name": "旅行の割り勘",
    "description": "誰がいくら払ったかを記録し、1人あたりの負担と精算(誰が誰にいくら払うか)を自動で計算する",
    "icon": "person.3",
    "theme": { "primaryColor": "#00796B" },
    "voiceEntry": "floating"
  },
  "initialScreen": "home",
  "entities": [
    {
      "id": "members",
      "name": "メンバー",
      "titleField": "name",
      "fields": [
        { "id": "name", "name": "名前", "type": "string", "required": true },
        { "id": "paid", "name": "支払済", "type": "currency", "unit": "円",
          "computed": { "agg": "sum", "entity": "expenses", "field": "amount", "filter": { "field": "payer", "op": "eq", "value": { "ref": "id" } } } },
        { "id": "share", "name": "負担額", "type": "currency", "unit": "円",
          "computed": { "op": "round", "args": [ { "op": "div", "args": [ { "agg": "sum", "entity": "expenses", "field": "amount" }, { "agg": "count", "entity": "members" } ] } ] } },
        { "id": "balance", "name": "残高", "type": "currency", "unit": "円",
          "computed": { "op": "sub", "args": [ { "ref": "paid" }, { "ref": "share" } ] } }
      ]
    },
    {
      "id": "expenses",
      "name": "支出",
      "titleField": "title",
      "fields": [
        { "id": "title", "name": "内容", "type": "string", "required": true },
        { "id": "amount", "name": "金額", "type": "currency", "required": true, "unit": "円" },
        { "id": "payer", "name": "払った人", "type": "ref", "refEntity": "members", "required": true },
        { "id": "date", "name": "日付", "type": "date", "defaultValue": "now" }
      ]
    }
  ],
  "screens": [
    {
      "id": "home",
      "title": "旅行の割り勘",
      "toolbar": [
        { "label": "メンバー", "icon": "person.badge.plus", "action": { "type": "navigate", "screen": "member_form", "presentation": "sheet" } }
      ],
      "components": [
        {
          "type": "hstack", "id": "summary", "area": "A1:F2",
          "children": [
            { "type": "stat", "label": "合計", "entity": "expenses", "aggregate": "sum", "field": "amount", "format": "currency" },
            { "type": "stat", "label": "1人あたり", "format": "currency",
              "value": { "op": "round", "args": [ { "op": "div", "args": [ { "agg": "sum", "entity": "expenses", "field": "amount" }, { "agg": "count", "entity": "members" } ] } ] } }
          ]
        },
        { "type": "table", "id": "members_table", "area": "A3:F5", "entity": "members",
          "columns": [ { "field": "name", "title": "名前" }, { "field": "paid", "title": "支払済" }, { "field": "balance", "title": "残高" } ] },
        { "type": "settlement", "id": "settle", "area": "A6:F8", "entity": "members", "nameField": "name", "balanceField": "balance" },
        {
          "type": "section", "id": "recent", "area": "A9:F11", "title": "支出",
          "children": [
            { "type": "list", "entity": "expenses", "item": { "title": "title", "subtitle": "payer", "trailing": "amount" },
              "sort": { "field": "date", "direction": "desc" }, "emptyText": "まだ支出がありません", "swipeToDelete": true,
              "onItemTap": { "type": "navigate", "screen": "expense_form", "presentation": "push" } }
          ]
        },
        { "type": "button", "id": "add", "area": "D12:F12", "label": "支出を追加", "icon": "plus",
          "action": { "type": "navigate", "screen": "expense_form", "presentation": "sheet" } }
      ]
    },
    {
      "id": "expense_form",
      "title": "支出",
      "entity": "expenses",
      "toolbar": [
        { "label": "保存", "action": { "type": "saveRecord", "entity": "expenses" } }
      ],
      "components": [
        {
          "type": "section", "title": "支出",
          "children": [
            { "type": "textField", "field": "title", "label": "内容", "placeholder": "夕食・レンタカーなど" },
            { "type": "numberField", "field": "amount", "label": "金額", "unit": "円" },
            { "type": "picker", "field": "payer", "label": "払った人", "style": "menu" },
            { "type": "datePicker", "field": "date", "label": "日付" }
          ]
        }
      ]
    },
    {
      "id": "member_form",
      "title": "メンバー",
      "entity": "members",
      "toolbar": [
        { "label": "保存", "action": { "type": "saveRecord", "entity": "members" } }
      ],
      "components": [
        {
          "type": "section", "title": "メンバー",
          "children": [
            { "type": "textField", "field": "name", "label": "名前", "placeholder": "たろう" }
          ]
        }
      ]
    }
  ]
}
