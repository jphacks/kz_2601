  {"id": "edit_family", "group": "edit", "base": "internal/ai/examples/kakeibo.json", "mode": "edit", "note": "#185 曖昧な要望 → proposal(共有の案)。案 1 を generate に流す",
   "steps": [{"say": "家族でも使いたい", "expect": "proposal", "generate": true, "optionsNot": ["投稿者"], "genNot": ["省き", "省いた", "出せない"]}]},
  {"id": "edit_benri", "group": "edit", "base": "internal/ai/examples/kakeibo.json", "mode": "edit", "note": "#184 曖昧な要望 → proposal(proposal の p50 を測る件数を増やす)",
