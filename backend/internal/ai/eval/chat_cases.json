  {"id": "edit_en_chart", "group": "edit-en", "locale": "en", "base": "internal/ai/examples/kakeibo.json", "capabilities": ["answer", "proposal"], "note": "#185 英語の質問 → 英語の answer(円グラフは集計タブに既にある)",
   "steps": [{"say": "Can this app show a pie chart of my spending?", "expect": "answer", "textAny": ["already", "stats", "summary", "tab"], "textNot": ["Category (this month)"]}]},
  {"id": "edit_en_label", "group": "edit-en", "locale": "en", "base": "internal/ai/examples/kakeibo.json", "capabilities": ["answer", "proposal"], "note": "#184 英語の answer でも画面のラベルは訳さず原文で引用する",
