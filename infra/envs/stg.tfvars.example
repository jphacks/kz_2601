# cp envs/stg.tfvars.example envs/stg.tfvars して値を埋める(stg.tfvars はコミットしない)
env        = "stg"
project_id = "tailorit-stg" # #288 の仮名。空いているかは作成時に確認
region     = "asia-northeast1"

# WIF: 既定は develop だけ
# wif_allowed_refs = ["refs/heads/develop"]

firestore_pitr_enabled      = false
firestore_delete_protection = true

# 初回は空(Artifact Registry にイメージが無い)。CI が 1 回デプロイした後に digest を入れて再 apply
purge_enabled   = true
purge_job_image = ""

billing_account     = "XXXXXX-XXXXXX-XXXXXX"
budget_display_name = "kz2601 stg monthly"
budget_amount       = 1500
budget_currency     = "JPY"

# 監視(docs/infra/observability.md・#295)。host は stg のプロジェクトにデプロイした後の URL に替える。
# stg がまだ prod のプロジェクト(jphacks-kz2601)にある間は、ai-stg / appconfig-stg
# (https://{ai,appconfig}-stg-378953239426.asia-northeast1.run.app)を prod.tfvars の monitored_services に足す
monitored_services = {
  "ai-stg"        = { host = "ai-stg-<project-number>.asia-northeast1.run.app", p95_latency_ms = 60000 }
  "appconfig-stg" = { host = "appconfig-stg-<project-number>.asia-northeast1.run.app", p95_latency_ms = 1500 }
}
alert_emails = ["you@example.com"]
