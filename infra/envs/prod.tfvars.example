# cp envs/prod.tfvars.example envs/prod.tfvars して値を埋める(prod.tfvars はコミットしない)
env        = "prod"
project_id = "jphacks-kz2601"
region     = "asia-northeast1"

# WIF: 既定は main だけ。import 直後に差分 0 を確かめるときは [](今と同じ「リポジトリだけ」)にする
# wif_allowed_refs = []

# Firestore: #288 の判断ではリリース前に有効化する。import 直後に差分 0 を確かめるときは false にする
firestore_pitr_enabled      = true
firestore_delete_protection = true

# 日次バックアップの保持(日)。0 で作らない
firestore_backup_retention_days = 14

# Firebase の API キーの制限(apikeys.tf)。Firebase がアプリ登録時に作ったキーを key_id で取り込む。
# key_id は Cloud Console > APIs & Services > Credentials のキーの ID。api_targets は今の制限と同じ一覧にし、
# 初回の plan で差分を見てから apply する(違う制限を入れるとアプリが動かなくなる)
# firebase_api_keys = {
#   ios = {
#     key_id         = "<キー ID>"
#     display_name   = "iOS key (auto created by Firebase)"
#     ios_bundle_ids = ["jp.kz2601.metamon"]
#     api_targets    = ["identitytoolkit.googleapis.com", "securetoken.googleapis.com", "firebaseinstallations.googleapis.com", "firebaseappcheck.googleapis.com", "firebasecrashlytics.googleapis.com"]
#   }
#   web = {
#     key_id       = "<キー ID>"
#     display_name = "Browser key (auto created by Firebase)"
#     api_targets  = ["identitytoolkit.googleapis.com", "securetoken.googleapis.com"]
#   }
# }

# 消去ジョブ: 今のジョブのイメージ(digest)。作成後のイメージ更新は Terraform は追わない
purge_enabled   = true
purge_job_image = "asia-northeast1-docker.pkg.dev/jphacks-kz2601/backend/backend@sha256:<digest>"

billing_account     = "XXXXXX-XXXXXX-XXXXXX"
budget_display_name = "kz2601 monthly"
budget_amount       = 4500
budget_currency     = "JPY"

# imports.tf(imports.prod.tf.example のコピー)を使う間だけ
# import_project_number = "378953239426"
# import_budget_id      = "<gcloud billing budgets list の name の末尾>"
# import_firestore_backup_schedule_id = "<gcloud firestore backups schedules list の name の末尾>"
