<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- photoField / videoField のカメラ(TakePicture / ACTION_VIDEO_CAPTURE)に渡す保存先(#862 / #863)。権限はアプリ側(PermissionCenter)が聞く -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.metamon.media"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/metamon_media_paths" />
        </provider>
        <!-- qrScanner(#866): Google Code Scanner の読み取りモジュールをインストール時に落とす(初回に押してから待たせない) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
    </application>
</manifest>
