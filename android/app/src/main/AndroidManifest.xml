<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 実行時の権限(#890)。聞くのは部品を使う直前(permissions/PermissionCenter)。マイクは :services で宣言済み -->
    <!-- 写真・動画・QR・ドラレコ。カメラの無い端末でも入れられるように required="false" -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 現在地・道案内・近くに着いたら通知。おおよそだけの許可でも使う。裏での取得(ACCESS_BACKGROUND_LOCATION)は持たない -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 通知(13+ だけ実行時の権限。12 / 12L は設定のオン・オフのみ) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 近くの端末と送り合う(nearbyShare)は Android にまだ無いので、次の権限は持たない。近距離共有(#878)で戻す:
         BLUETOOTH_SCAN(neverForLocation)・BLUETOOTH_ADVERTISE・BLUETOOTH_CONNECT・NEARBY_WIFI_DEVICES(neverForLocation)。
         minSdk 31 なので古い BLUETOOTH / BLUETOOTH_ADMIN は戻す時も要らない -->
    <!-- 生成アプリの通知(#886): 再起動の後に予約し直す -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- アラーム(alarm: true)だけ正確な時刻で鳴らす。利用者が設定で許可した時だけ使い、無ければ正確でないアラーム。
         USE_EXACT_ALARM・USE_FULL_SCREEN_INTENT は Play で目覚まし・通話のアプリに限られるので持たない -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Health Connect(healthStat)の権限は、その部品と権限の理由の画面を入れる時に足す(#890 の子 Issue) -->

    <application
        android:name=".MetamonApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Metamon">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- シェアリンク tailorit://import/<token>(#901)。https の /s/<token>(App Links)は署名の指紋が決まってから -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tailorit" android:host="import" />
            </intent-filter>
        </activity>
        <!-- 表示言語(#843)。端末の設定 > アプリ の「アプリの設定」からも開ける -->
        <activity
            android:name=".language.LanguageSettingsActivity"
            android:exported="true"
            android:label="@string/language_title">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 生成アプリの通知(#886): 時刻が来た・止めた(自分の PendingIntent だけ)と、再起動・時刻の変更・更新(OS) -->
        <receiver
            android:name=".notifications.NotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- 他の人の行動で届く通知(FCM・#887)。トークンは通知を出せる・サインイン済みの時にだけ取る(自動では作らない) -->
        <service
            android:name=".push.MetamonMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- 裏で届いた notification つきのメッセージは OS が出す。そのチャンネルとアイコン(LocalNotifications.CHANNEL_OTHERS) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="others" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>

</manifest>
