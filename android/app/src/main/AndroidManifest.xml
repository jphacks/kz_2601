<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 実行時の権限(#890)。聞くのは部品を使う直前(permissions/PermissionCenter)。マイクは :services で宣言済み -->
    <!-- 写真・動画・QR・ドラレコ。カメラの無い端末でも入れられるように required="false" -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 現在地・道案内・近くに着いたら通知。現在地と道案内はおおよそだけの許可でも使う -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 場所に着いたら知らせる(near)だけが使う。Geofencing はアプリを閉じている間に着いたかを OS が端末の中で見るので、
         正確な位置と裏での位置の両方が要る。前面の位置が許可された後に、説明の画面を出してから聞く。
         Play Console の申告の文: docs/android/play-background-location.md -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 位置の記録(locationTracker・#869)の Foreground Service(type location・宣言は :renderer)。前面で開始するので裏での位置は使わない。
         Play Console の「フォアグラウンド サービスの権限」の申告が要る(人の作業) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 通知(13+ だけ実行時の権限。12 / 12L は設定のオン・オフのみ) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 近くの端末と送り合う(nearbyShare・Nearby Connections・#1380)。minSdk 31 なので古い BLUETOOTH / BLUETOOTH_ADMIN は要らない。
         13+ は NEARBY_WIFI_DEVICES、12 / 12L は Wi-Fi の状態と ACCESS_FINE_LOCATION(上で宣言済み)を使う -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.CHANGE_WIFI_STATE"
        android:maxSdkVersion="32" />
    <!-- 生成アプリの通知(#886): 再起動の後に予約し直す -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- アラーム(alarm: true)だけ正確な時刻で鳴らす。利用者が設定で許可した時だけ使い、無ければ正確でないアラーム。
         USE_EXACT_ALARM・USE_FULL_SCREEN_INTENT は Play で目覚まし・通話のアプリに限られるので持たない -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Health Connect(healthStat)の権限は、その部品と権限の理由の画面を入れる時に足す(#890 の子 Issue) -->

    <application
        android:name=".MetamonApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Metamon">
        <!-- play-services-nearby が持ち込む接触確認(Exposure Notifications)の受け口。使わないので外す(#1380) -->
        <service
            android:name="com.google.android.gms.nearby.exposurenotification.WakeUpService"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <!-- 共有リンク・通知から開いた時も、開いている画面で受ける(onNewIntent・iOS と同じく 1 つの画面) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- シェアリンク tailorit://import/<token>(#901) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tailorit" android:host="import" />
            </intent-filter>
            <!-- App Links https://tailor-it.app/s/<token>(#1272)。サイトに assetlinks.json が置かれるまではブラウザで開く(docs/infra/app-links) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="tailor-it.app" android:pathPrefix="/s/" />
            </intent-filter>
        </activity>
        <!-- 表示言語(#843)。端末の設定 > アプリ の「アプリの設定」からも開ける -->
        <activity
            android:name=".language.LanguageSettingsActivity"
            android:exported="true"
            android:label="@string/language_title">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 生成アプリの通知(#886): 時刻が来た・止めた(自分の PendingIntent だけ)と、再起動・時刻の変更・更新(OS) -->
        <receiver
            android:name=".notifications.NotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- 他の人の行動で届く通知(FCM・#887)。トークンは通知を出せる・サインイン済みの時にだけ取る(自動では作らない) -->
        <service
            android:name=".push.MetamonMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- 裏で届いた notification つきのメッセージは OS が出す。そのチャンネルとアイコン(LocalNotifications.CHANNEL_OTHERS) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="others" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>

</manifest>
