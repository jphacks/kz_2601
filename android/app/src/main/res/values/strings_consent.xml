<?xml version="1.0" encoding="utf-8"?>
<!-- AI へのデータ送信の同意・設定のプライバシー(#888)。文言の正は iOS の Localizable.xcstrings(通常の版) -->
<resources>
    <string name="consent_agree">同意して使う</string>
    <string name="consent_ai_button">「AI で書く」ボタン(文を作る・要約・分類・書き直し・抜き出し・提案)は、押した時だけ送ります。短い答えは、端末の中の AI が使える時は送らず、使えない時だけ最近の記録と入力中の文字(最大 4KB)を送ります。長い答えのボタンは、いつも最大 16KB を送ります。共有のアプリで材料にするのは、自分が入れた記録だけです。</string>
    <string name="consent_ai_chat">「AI と話す」部品は、送るたびに、そのアプリに保存した自分の会話の直近の発言(最大 20 件・16KB)を送ります。参考にする記録帳が決めてあるアプリでは、その記録帳の自分の記録の新しいもの(最大 20 件・8KB)も送ります。写真は「写真を材料にするボタン」を押した時だけ、縮めた 1 枚(JPEG・長い辺 1024 ピクセル以下)を送ります。音声・動画は送りません。</string>
    <string name="consent_destination">送り先: Tailor It のサーバー(Google Cloud)を経由して Anthropic, PBC(米国)へ。送った内容は、アプリを作る・ボタンの文を作る・会話の返事を作るためだけに使います。</string>
    <string name="consent_intro">アプリを作る・直すときは、次の内容を Anthropic 社の AI(Claude)に送ります。</string>
    <string name="consent_item_chat">AI との会話の履歴</string>
    <string name="consent_item_design">今のアプリの設計(画面・項目・アプリ名など)</string>
    <string name="consent_item_utterance">話した内容・入力した文(端末内で文字にしたもの。音声そのものは送りません)</string>
    <string name="consent_later">あとで</string>
    <string name="consent_no_records">アプリを作る・直すときに、記録したデータ(数値・メモ・写真など)の中身は送りません。</string>
    <string name="consent_reconsent">AI に送る内容の説明を改めました。もう一度ご確認ください。</string>
    <string name="consent_title">AI へのデータ送信について</string>
    <string name="consent_without">同意しなくても、作ったアプリの閲覧・記録はできます。AI を使う機能だけが使えません。同意は設定からいつでも取り消せます(送信済みの内容は取り消せません)。</string>
    <string name="legal_privacy_policy">プライバシーポリシー</string>
